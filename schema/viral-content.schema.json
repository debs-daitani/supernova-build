{
  "displayName": "Viral Content",
  "id": "ViralContent",
  "fields": [
    {
      "key": "userId",
      "type": "text",
      "description": "User who saved this (null if public trending content)"
    },
    {
      "key": "platform",
      "type": "text",
      "description": "Platform: twitter, instagram, tiktok, youtube, linkedin, facebook"
    },
    {
      "key": "url",
      "type": "text",
      "description": "Original content URL"
    },
    {
      "key": "author",
      "type": "text",
      "description": "Content creator username/name"
    },
    {
      "key": "authorFollowers",
      "type": "number",
      "description": "Author's follower count at time of capture"
    },
    {
      "key": "contentType",
      "type": "text",
      "description": "Type: post, video, reel, thread, article, carousel, story"
    },
    {
      "key": "title",
      "type": "text",
      "description": "Content title or headline"
    },
    {
      "key": "caption",
      "type": "text",
      "description": "Content text/caption"
    },
    {
      "key": "transcript",
      "type": "text",
      "description": "Video transcript if available"
    },
    {
      "key": "hashtags",
      "type": "object",
      "description": "Array of hashtags used"
    },
    {
      "key": "mentions",
      "type": "object",
