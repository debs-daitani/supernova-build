generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  password           String
  name               String?
  role               UserRole           @default(USER)
  subscriptionStatus SubscriptionStatus @default(INACTIVE)
  subscriptionTier   SubscriptionTier   @default(NONE)
  subscriptionStart  DateTime?
  subscriptionEnd    DateTime?
  stripeCustomerId   String?
  stripePriceId      String?
  isBetaTester       Boolean            @default(false)
  bio                String?
  location           String?
  niche              String?
  skills             String[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  lastLogin          DateTime?
  commitments        Commitment[]
  conversations      Conversation[]
  decisions          Decision[]
  energyLogs         EnergyLog[]
  extractedEntities  ExtractedEntity[]
  folders            Folder[]
  loopDetections     LoopDetection[]
  messages           Message[]
  memories           UserMemory[]
  userPatterns       UserPattern[]
  voiceMemos         VoiceMemo[]
  assignedDeals      Deal[]       @relation("DealAssignee")
  assignedTasks      Task[]       @relation("TaskAssignee")
  assignedActivities Activity[]   @relation("ActivityAssignee")
  blogPosts          BlogPost[]

  // VENUED Relations
  venuedProjects        VenuedProject[]
  venuedTasks           VenuedTask[]
  venuedStats           VenuedStats?
  venuedTimeTracking    VenuedTimeTracking[]
  venuedHyperfocus      VenuedHyperfocus[]
  venuedEnergyLogs      VenuedEnergyLog[]
  venuedBrainDumps      VenuedBrainDump[]
  venuedDopamineRewards VenuedDopamineReward[]

  // Finance Relations
  financeIncome         FinanceIncome[]
  financeExpenses       FinanceExpense[]
  financeInvoices       FinanceInvoice[]
  invoicePrefixes       InvoicePrefix[]

  // Calendar Relations
  calendarConnection    CalendarConnection?
  calendarEvents        CalendarEvent[]

  // Social Media Relations
  socialAccounts        SocialAccount[]
  socialPosts           SocialPost[]

  @@index([email])
}

model Conversation {
  id                  String               @id @default(cuid())
  userId              String
  title               String               @default("New Conversation")
  mode                CoachingMode         @default(GENERAL)
  archived            Boolean              @default(false)
  folderId            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  lastMessageAt       DateTime             @default(now())
  folder              Folder?              @relation(fields: [folderId], references: [id])
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationSummary ConversationSummary?
  energyLogs          EnergyLog[]
  loopDetections      LoopDetection[]
  messages            Message[]
  memories            UserMemory[]

  @@index([userId])
  @@index([userId, archived])
  @@index([userId, lastMessageAt])
  @@index([folderId])
  @@index([mode])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  role           String
  content        String
  tokensUsed     Int?
  modelUsed      String?      @default("claude-3-5-sonnet-20241022")
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([userId])
  @@index([createdAt])
}

model UserMemory {
  id                   String        @id @default(cuid())
  userId               String
  memoryType           MemoryType
  content              String
  sourceConversationId String?
  importanceScore      Float         @default(5.0)
  pillarTags           String[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  sourceConversation   Conversation? @relation(fields: [sourceConversationId], references: [id])
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, memoryType])
  @@index([importanceScore])
}

model EnergyLog {
  id             String       @id @default(cuid())
  userId         String
  conversationId String
  energyLevel    String
  timeOfDay      String
  dayOfWeek      Int
  messageLength  Int
  timestamp      DateTime     @default(now())
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, timestamp])
}

model Commitment {
  id             String    @id @default(cuid())
  userId         String
  description    String
  deadline       DateTime?
  pillar         String?
  status         String    @default("active")
  createdAt      DateTime  @default(now())
  commitmentType String
  currentStreak  Int       @default(0)
  lastCheckIn    DateTime?
  longestStreak  Int       @default(0)
  updatedAt      DateTime  @updatedAt
  checkIns       CheckIn[]
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
}

model CheckIn {
  id           String     @id @default(cuid())
  commitmentId String
  createdAt    DateTime   @default(now())
  note         String?
  status       String
  commitment   Commitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)

  @@index([commitmentId])
}

model Decision {
  id             String    @id @default(cuid())
  userId         String
  conversationId String?
  question       String
  options        String[]
  chosenOption   String?
  timesAsked     Int       @default(1)
  createdAt      DateTime  @default(now())
  decidedAt      DateTime?
  status         String    @default("pending")
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
}

model LoopDetection {
  id              String       @id @default(cuid())
  userId          String
  loopType        String
  conversationId  String
  createdAt       DateTime     @default(now())
  isActive        Boolean      @default(true)
  lastTriggered   DateTime     @default(now())
  messages        String[]
  occurrenceCount Int          @default(1)
  updatedAt       DateTime     @updatedAt
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
}

model DopamineMenuItem {
  id            String   @id @default(cuid())
  userId        String?
  title         String
  description   String
  pillar        String?
  timesOffered  Int      @default(0)
  createdAt     DateTime @default(now())
  category      String
  duration      String
  isGlobal      Boolean  @default(false)
  timesAccepted Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([isGlobal])
}

model VoiceMemo {
  id         String   @id @default(cuid())
  userId     String
  audioUrl   String?
  duration   Int?
  summary    String?
  createdAt  DateTime @default(now())
  status     String   @default("pending")
  transcript String?
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model ExtractedEntity {
  id         String   @id @default(cuid())
  userId     String
  entityType String
  name       String
  context    String?
  createdAt  DateTime @default(now())
  mentions   Int      @default(1)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, entityType])
}

model UserPattern {
  id          String   @id @default(cuid())
  userId      String
  patternType String
  description String
  createdAt   DateTime @default(now())
  occurrences Int      @default(1)
  strength    Float    @default(0.5)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ConversationSummary {
  id             String       @id @default(cuid())
  conversationId String       @unique
  summary        String
  keyTopics      String[]
  actionItems    String[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  mood           String?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Folder {
  id            String         @id @default(cuid())
  userId        String
  name          String
  color         String?        @default("#8B5CF6")
  order         Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Album {
  id          String       @id @default(cuid())
  title       String
  description String?
  order       Int          @default(0)
  isPublic    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  coverImage  String?
  mode        CoachingMode
  tracks      Track[]

  @@index([mode])
  @@index([isPublic])
}

model Track {
  id        String   @id @default(cuid())
  albumId   String
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  content   String
  sections  Json?
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId])
}

model ContentChunk {
  id         String   @id @default(cuid())
  content    String
  pillar     String?
  createdAt  DateTime @default(now())
  embedding  Float[]
  keywords   String[]
  sourceId   String?
  sourceName String?
  sourceType String
  updatedAt  DateTime @updatedAt

  @@index([pillar])
  @@index([sourceType])
}

model Program {
  id          String       @id @default(cuid())
  title       String
  description String
  programType ProgramType
  mode        CoachingMode
  content     String
  objectives  String[]
  outcomes    String[]
  duration    String?
  level       String?
  tags        String[]
  isPublic    Boolean      @default(false)
  price       Float?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([mode])
  @@index([programType])
  @@index([isPublic])
}

model KnowledgeProgram {
  id          String   @id @default(cuid())
  title       String
  description String
  pillar      String
  updatedAt   DateTime @updatedAt
  content     String
  createdAt   DateTime @default(now())

  @@index([pillar])
}

model Quiz {
  id              String                  @id @default(cuid())
  userId          String?
  title           String
  description     String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  avgScore        Float?
  isPublic        Boolean                 @default(false)
  pillar          String?
  totalResponses  Int                     @default(0)
  recommendations ProgramRecommendation[]
  questions       Question[]
  analytics       QuizAnalytics?
  resultTiers     ResultTier[]

  @@index([isPublic])
  @@index([pillar])
}

model Question {
  id        String   @id @default(cuid())
  quizId    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  options   Json
  text      String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model ResultTier {
  id          String   @id @default(cuid())
  quizId      String
  name        String
  description String
  minScore    Float
  maxScore    Float
  createdAt   DateTime @default(now())
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model ProgramRecommendation {
  id          String   @id @default(cuid())
  quizId      String
  programId   String
  createdAt   DateTime @default(now())
  maxScore    Float
  minScore    Float
  programName String
  reason      String?
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model QuizAnalytics {
  id                String   @id @default(cuid())
  quizId            String   @unique
  createdAt         DateTime @default(now())
  avgCompletionTime Float?
  highScoreCount    Int      @default(0)
  lowScoreCount     Int      @default(0)
  mediumScoreCount  Int      @default(0)
  totalCompletions  Int      @default(0)
  totalStarts       Int      @default(0)
  updatedAt         DateTime @updatedAt
  quiz              Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model EmailSubscriber {
  id        String       @id @default(cuid())
  email     String       @unique
  tags      String[]
  updatedAt DateTime     @updatedAt
  createdAt DateTime     @default(now())
  name      String?
  status    String       @default("active")
  source    String?
  events    EmailEvent[]

  @@index([email])
  @@index([status])
}

model EmailCampaign {
  id          String       @id @default(cuid())
  name        String
  subject     String
  sentCount   Int          @default(0)
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  clickCount  Int          @default(0)
  content     String
  openCount   Int          @default(0)
  status      String       @default("draft")
  events      EmailEvent[]

  @@index([status])
}

model EmailEvent {
  id           String          @id @default(cuid())
  campaignId   String?
  subscriberId String
  createdAt    DateTime        @default(now())
  eventType    String
  metadata     Json?
  campaign     EmailCampaign?  @relation(fields: [campaignId], references: [id])
  subscriber   EmailSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([subscriberId])
  @@index([campaignId])
  @@index([eventType])
}

model Contact {
  id          String     @id @default(cuid())
  firstName   String
  lastName    String?
  email       String?
  phone       String?
  company     String?
  tags        String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  lastContact DateTime?
  notes       String?
  userId      String
  source      String?
  status      String     @default("lead")

  deals            Deal[]
  tasks            Task[]
  activities       Activity[]
  financeIncome    FinanceIncome[]
  financeInvoices  FinanceInvoice[]
  calendarEvents   CalendarEvent[]

  @@index([userId])
  @@index([userId, status])
}

model Deal {
  id                String     @id @default(cuid())
  title             String
  value             Float
  currency          String     @default("USD")
  stage             String     @default("LEAD")
  probability       Int        @default(0)
  expectedCloseDate DateTime?
  actualCloseDate   DateTime?
  notes             String?
  customFields      Json?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  contactId         String
  assignedToId      String?

  contact           Contact    @relation(fields: [contactId], references: [id])
  assignedTo        User?      @relation("DealAssignee", fields: [assignedToId], references: [id])
  tasks             Task[]
  activities        Activity[]

  @@index([contactId])
  @@index([assignedToId])
  @@index([stage])
}

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  priority     String    @default("MEDIUM")
  status       String    @default("PENDING")
  dueDate      DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  contactId    String?
  dealId       String?
  assignedToId String?

  contact      Contact?  @relation(fields: [contactId], references: [id])
  deal         Deal?     @relation(fields: [dealId], references: [id])
  assignedTo   User?     @relation("TaskAssignee", fields: [assignedToId], references: [id])

  @@index([contactId])
  @@index([dealId])
  @@index([assignedToId])
  @@index([status])
}

model Activity {
  id           String    @id @default(cuid())
  type         String
  subject      String
  description  String?
  dueDate      DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  contactId    String?
  dealId       String?
  assignedToId String?

  contact      Contact?  @relation(fields: [contactId], references: [id])
  deal         Deal?     @relation(fields: [dealId], references: [id])
  assignedTo   User?     @relation("ActivityAssignee", fields: [assignedToId], references: [id])

  @@index([contactId])
  @@index([dealId])
  @@index([assignedToId])
  @@index([type])
}

model StripeCustomer {
  id               String   @id @default(cuid())
  userId           String   @unique
  stripeCustomerId String   @unique
  email            String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([stripeCustomerId])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  stripeSubscriptionId String    @unique
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  canceledAt           DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  priceId              String
  status               String

  invoices             Invoice[]
  payments             Payment[]

  @@index([userId])
  @@index([stripeSubscriptionId])
}

model Invoice {
  id                String    @id @default(cuid())
  userId            String
  subscriptionId    String
  stripeInvoiceId   String    @unique
  amountDue         Int
  amountPaid        Int
  currency          String
  status            String
  hostedInvoiceUrl  String?
  invoicePdf        String?
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  subscription      Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@index([stripeInvoiceId])
}

model Payment {
  id                     String   @id @default(cuid())
  userId                 String
  subscriptionId         String
  stripePaymentIntentId  String   @unique
  amount                 Int
  currency               String
  status                 String
  description            String?
  receiptUrl             String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  subscription           Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@index([stripePaymentIntentId])
}

enum UserRole {
  USER
  ADMIN
  COACH
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  PAST_DUE
}

enum SubscriptionTier {
  NONE
  VENUED
  DAITANIVERSE
  BETA_TESTER
}

enum CoachingMode {
  BODY
  BRAIN
  BUSINESS
  GENERAL
}

enum MemoryType {
  FACT
  PREFERENCE
  GOAL
  CONTEXT
  STRUGGLE
  STRENGTH
  INSIGHT
}

enum ProgramType {
  COURSE
  WORKSHOP
  COACHING_PROGRAM
  RESOURCE
  TEMPLATE
}

// Blog System
model BlogPost {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  content         String
  excerpt         String?
  featuredImage   String?
  status          PostStatus  @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  authorId        String
  author          User        @relation(fields: [authorId], references: [id])
  categories      BlogCategory[]
  tags            BlogTag[]

  // SEO
  metaTitle       String?
  metaDescription String?

  // Stats
  viewCount       Int         @default(0)

  @@index([status])
  @@index([authorId])
  @@index([publishedAt])
}

enum PostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

model BlogCategory {
  id    String     @id @default(cuid())
  name  String     @unique
  slug  String     @unique
  posts BlogPost[]
}

model BlogTag {
  id    String     @id @default(cuid())
  name  String     @unique
  slug  String     @unique
  posts BlogPost[]
}

// ============================================
// VENUED - Project Management System
// ============================================

model VenuedProject {
  id          String              @id @default(cuid())
  userId      String
  name        String
  description String?
  status      VenuedProjectStatus @default(PLANNING)
  startDate   DateTime?
  targetDate  DateTime?
  progress    Int                 @default(0)
  priority    VenuedPriority      @default(MEDIUM)
  tags        String[]
  color       String?             @default("#FF008E")
  archived    Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  phases VenuedPhase[]
  tasks  VenuedTask[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, archived])
}

model VenuedPhase {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  order       Int      @default(0)
  color       String?  @default("#00F0E9")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project VenuedProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   VenuedTask[]

  @@index([projectId])
}

model VenuedTask {
  id              String           @id @default(cuid())
  userId          String
  projectId       String?
  phaseId         String?
  title           String
  description     String?
  energyLevel     VenuedEnergy     @default(MEDIUM)
  estimatedMins   Int?
  difficulty      VenuedDifficulty @default(MEDIUM)
  isHyperfocus    Boolean          @default(false)
  isQuickWin      Boolean          @default(false)
  dependencies    String[]
  completed       Boolean          @default(false)
  completedAt     DateTime?
  order           Int              @default(0)
  scheduledDate   DateTime?
  scheduledTime   String?
  timeSpent       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project VenuedProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase   VenuedPhase?   @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, completed])
  @@index([userId, scheduledDate])
  @@index([projectId])
  @@index([phaseId])
}

model VenuedStats {
  id             String   @id @default(cuid())
  userId         String   @unique
  totalPoints    Int      @default(0)
  level          Int      @default(1)
  tasksCompleted Int      @default(0)
  focusMinutes   Int      @default(0)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveAt   DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ADHD Support Tools (Entourage)

model VenuedTimeTracking {
  id              String       @id @default(cuid())
  userId          String
  taskId          String?
  taskName        String
  taskType        String?
  estimatedMins   Int
  actualMins      Int
  date            DateTime
  energyLevel     VenuedEnergy @default(MEDIUM)
  createdAt       DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
}

model VenuedHyperfocus {
  id                 String   @id @default(cuid())
  userId             String
  startTime          DateTime
  endTime            DateTime
  durationMins       Int
  trigger            String?
  taskType           String?
  taskName           String?
  productivityRating Int?
  notes              String?
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, startTime])
}

model VenuedEnergyLog {
  id        String       @id @default(cuid())
  userId    String
  level     VenuedEnergy
  notes     String?
  timestamp DateTime     @default(now())
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, timestamp])
}

model VenuedBrainDump {
  id              String   @id @default(cuid())
  userId          String
  content         String
  converted       Boolean  @default(false)
  convertedTaskId String?
  archived        Boolean  @default(false)
  tags            String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, archived])
}

model VenuedDopamineReward {
  id               String                @id @default(cuid())
  userId           String
  reward           String
  category         VenuedRewardCategory  @default(OTHER)
  usageCount       Int                   @default(0)
  motivationRating Int?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

