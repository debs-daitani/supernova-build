{
  "collectionName": "SupernovaPreferences",
  "displayName": "Supernova Preferences",
  "permissions": {
    "read": "Anyone",
    "write": "Anyone",
    "delete": "Admin"
  },
  "fields": [
    {
      "name": "_id",
      "type": "text",
      "required": true,
      "description": "Auto-generated unique identifier"
    },
    {
      "name": "userId",
      "type": "text",
      "required": true,
      "description": "Reference to Users.userId"
    },
    {
      "name": "language",
      "type": "text",
      "required": false,
      "description": "Preferred language (e.g., 'en', 'es')"
    },
    {
      "name": "timezone",
      "type": "text",
      "required": false,
      "description": "User timezone"
    },
    {
      "name": "notificationsEnabled",
      "type": "boolean",
      "required": false,
      "description": "Enable notifications"
    },
    {
      "name": "emailNotifications",
      "type": "boolean",
      "required": false,
      "description": "Enable email notifications"
    },
    {
      "name": "theme",
      "type": "text",
      "required": false,
      "description": "UI theme preference (light, dark, auto)"
    },
    {
      "name": "conversationStyle",
      "type": "text",
      "required": false,
      "description": "AI response style (formal, casual, technical)"
    },
    {
      "name": "responseLength",
      "type": "text",
      "required": false,
      "description": "Preferred response length (short, medium, long)"
    },
    {
      "name": "memoryRetention",
      "type": "number",
      "required": false,
      "description": "Memory retention days (30, 60, 90, 365)"
    },
    {
      "name": "personalInfo",
      "type": "object",
      "required": false,
      "description": "Stored personal information"
    },
    {
      "name": "customSettings",
      "type": "object",
      "required": false,
      "description": "Custom preference key-value pairs"
    },
    {
      "name": "updatedAt",
      "type": "date",
      "required": true,
      "description": "Last update timestamp"
    }
  ],
  "indexes": [
    {
      "name": "userId_unique",
      "fields": ["userId"],
      "unique": true
    },
    {
      "name": "updatedAt_index",
      "fields": ["updatedAt"],
      "unique": false
