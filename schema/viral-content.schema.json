    },
    {
      "key": "discoveredAt",
      "type": "datetime",
      "description": "When we discovered this content"
    },
    {
      "key": "views",
      "type": "number",
      "description": "View count"
    },
    {
      "key": "likes",
      "type": "number",
      "description": "Like count"
    },
    {
      "key": "comments",
      "type": "number",
      "description": "Comment count"
    },
    {
      "key": "shares",
      "type": "number",
      "description": "Share count"
    },
    {
      "key": "saves",
      "type": "number",
      "description": "Save/bookmark count"
    },
    {
      "key": "engagementRate",
      "type": "number",
