// ============================================
// PHASE 2AN - MICROBLOGGING PLATFORM
// ============================================

model MicroPost {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  content       String

  mediaUrls     String[]
  mediaType     String?

  pollOptions   Json?
  pollEndsAt    DateTime?

  isThread      Boolean       @default(false)
  threadId      String?
  threadOrder   Int?

