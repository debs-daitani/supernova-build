{
  "name": "supernova-ai-memory-system",
  "version": "1.0.0",
  "description": "Comprehensive memory system architecture for SUPERNova AI on Wix platform",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon server/src/server.js",
    "start": "node server/src/server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{js,ts,json,md}\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed:tiers": "node server/src/seed-tiers.js",
    "test:subscription": "node server/src/test-subscription.js"
  },
  "keywords": [
    "ai",
    "memory-system",
    "wix",
    "chatbot",
    "conversation",
    "context-management",
    "supernova"
  ],
  "author": "SUPERNova AI Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/debs-daitani/supernova-build.git"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@prisma/client": "^7.0.0",
    "dotenv": "^17.2.3",
    "eslint": "^8.0.0",
    "nodemon": "^3.1.11",
    "prettier": "^2.8.0",
    "prisma": "^7.0.0"
  },
  "wix": {
    "collections": [
      "SupernovaUsers",
      "SupernovaConversations",
      "SupernovaMessages",
      "SupernovaSessions",
      "SupernovaPreferences",
      "SupernovaKnowledge",
      "SupernovaContext",
      "SupernovaMetadata"
    ],
    "services": [
      "memoryService",
      "sessionService",
      "conversationService",
      "userService",
      "contextService"
    ]
  }
}
