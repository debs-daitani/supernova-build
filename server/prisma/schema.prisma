  @@index([videoId])
  @@index([userId])
}

model VideoView {
  id            String        @id @default(cuid())
  videoId       String
  video         Video         @relation(fields: [videoId], references: [id], onDelete: Cascade)

  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

