// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model (simplified - can be extended with NextAuth later)
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  firstName     String?
  lastName      String?
  username      String?   @unique
  passwordHash  String?

  // Profile fields
  profilePhotoUrl String?
  bio             String?   @db.Text
  pronouns        String?

  // Social links
  twitterHandle   String?
  linkedinUrl     String?
  instagramHandle String?
  websiteUrl      String?

  // Preferences
  timezone        String?   @default("UTC")
  theme           String?   @default("SYSTEM") // LIGHT, DARK, SYSTEM
  language        String?   @default("en")

  // Legacy field (for backwards compatibility)
  avatar        String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // Soft delete

  websites        Website[]
  blocks          WebsiteBlock[]
  formSubmissions FormSubmission[]
  preferences     UserPreferences?
  designs         UserDesign[]
  designAssets    DesignAsset[]
  brandKit        BrandKit?
  aiImages        AIImage[]
  videos          Video[]
  videoClips      VideoClip[]
  forumThreads    ForumThread[]
  forumPosts      ForumPost[]
  forumReactions  ForumReaction[]
  reputation      UserReputation?
  forumSubscriptions ForumSubscription[]
  forumReports    ForumReport[]
  products        Product[]
  ordersBuyer     Order[] @relation("BuyerOrders")
  ordersSeller    Order[] @relation("SellerOrders")
  carts           Cart[]
  productReviews  ProductReview[]
  coupons         Coupon[]
  payoutRequests  PayoutRequest[]
  aiVideos        AIVideo[]
  aiVideoTemplates AIVideoTemplate[]

  @@map("users")
}

// User Preferences model
model UserPreferences {
  id        String   @id @default(cuid())
  userId    String   @unique

  // Email preferences
  emailMarketing Boolean @default(true)
  emailUpdates   Boolean @default(true)
  emailDigest    Boolean @default(true)
  emailSupport   Boolean @default(true)

  // Notification preferences
  notifBrowser   Boolean @default(false)
  notifEmail     Boolean @default(true)
  notifInApp     Boolean @default(true)

  // Per-feature notifications
  notifTickets   Boolean @default(true)
  notifCampaigns Boolean @default(true)
  notifSocial    Boolean @default(true)
  notifWebsites  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// Website model
model Website {
  id              String    @id @default(cuid())
  userId          String
  name            String
  domain          String    @unique  // subdomain or custom domain
  subdomain       String    @unique  // username.daitaniverse.site
  isPublished     Boolean   @default(false)

  // Theme settings (stored as JSON)
  theme           Json?     @default("{\"primaryColor\":\"#ec4899\",\"secondaryColor\":\"#8b5cf6\",\"accentColor\":\"#f59e0b\",\"fontFamily\":\"Inter\",\"fontHeadingFamily\":\"Montserrat\"}")

  // Branding
  favicon         String?
  logo            String?

  // SEO
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?

  // Analytics & Custom Code
  analyticsCode   String?   @db.Text
  customCSS       String?   @db.Text
  customJS        String?   @db.Text
  robotsTxt       String?   @db.Text

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  publishedAt     DateTime?

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages           WebsitePage[]

  @@index([userId])
  @@index([domain])
  @@index([subdomain])
  @@map("websites")
}

// WebsitePage model
model WebsitePage {
  id              String    @id @default(cuid())
  websiteId       String
  title           String
  slug            String
  isHomepage      Boolean   @default(false)

  // Page content (stored as JSON - array of blocks/sections)
  content         Json      @default("[]")

  // SEO
  seoTitle        String?
  seoDescription  String?
  seoImage        String?

  isPublished     Boolean   @default(false)
  order           Int       @default(0)  // for navigation menu ordering

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  website         Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, slug])
  @@index([websiteId])
  @@index([slug])
  @@map("website_pages")
}

// WebsiteBlock model (reusable blocks)
model WebsiteBlock {
  id              String    @id @default(cuid())
  userId          String
  name            String
  category        String    // hero, features, testimonials, pricing, etc.

  thumbnail       String?
  preview         String?   @db.Text

  // Block structure (stored as JSON)
  content         Json

  isPublic        Boolean   @default(false)  // shared blocks

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([isPublic])
  @@map("website_blocks")
}

// WebsiteTemplate model
model WebsiteTemplate {
  id              String    @id @default(cuid())
  name            String
  category        String    // landing-page, portfolio, business, blog, etc.
  description     String?   @db.Text

  thumbnail       String?
  preview         String?   @db.Text

  // Template pages structure (stored as JSON)
  pages           Json      // array of page structures

  // Theme settings for template
  theme           Json?

  isPublic        Boolean   @default(true)
  isFeatured      Boolean   @default(false)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([category])
  @@index([isPublic])
  @@index([isFeatured])
  @@map("website_templates")
}

// FormSubmission model
model FormSubmission {
  id              String    @id @default(cuid())
  userId          String    // website owner
  websiteId       String
  pageId          String?
  formName        String    // contact-form, newsletter, etc.

  // Form data (stored as JSON)
  data            Json

  // Common fields (extracted for easy filtering)
  name            String?
  email           String?
  phone           String?
  message         String?   @db.Text

  isRead          Boolean   @default(false)
  ipAddress       String?
  userAgent       String?   @db.Text

  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([websiteId])
  @@index([formName])
  @@index([isRead])
  @@index([createdAt])
  @@map("form_submissions")
}

// ========================================
// DESIGN TOOLS MODELS
// ========================================

// DesignTemplate model (pre-made templates)
model DesignTemplate {
  id          String   @id @default(cuid())
  name        String
  category    String   // social-media, marketing, business, youtube, other
  
  // Dimensions
  width       Int
  height      Int
  
  // Visuals
  thumbnailUrl String?
  previewUrl   String?
  
  // Canvas data (Fabric.js JSON)
  jsonData    Json
  
  // Metadata
  tags        String[] @default([])
  isPublic    Boolean  @default(true)
  createdBy   String?  // userId or null for platform templates
  usageCount  Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  designs     UserDesign[]
  
  @@index([category])
  @@index([isPublic])
  @@index([createdBy])
  @@map("design_templates")
}

// UserDesign model (user-created designs)
model UserDesign {
  id           String   @id @default(cuid())
  userId       String
  name         String
  
  // Template reference
  templateId   String?
  
  // Dimensions
  width        Int
  height       Int
  
  // Visuals
  thumbnailUrl String?
  
  // Canvas data (Fabric.js JSON)
  jsonData     Json
  
  // Metadata
  category     String?
  tags         String[] @default([])
  isPublic     Boolean  @default(false)
  
  lastEditedAt DateTime @updatedAt
  createdAt    DateTime @default(now())
  
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template     DesignTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([templateId])
  @@index([category])
  @@map("user_designs")
}

// DesignAsset model (uploaded images, icons, etc.)
model DesignAsset {
  id           String   @id @default(cuid())
  userId       String
  name         String
  type         String   // IMAGE, ICON, SHAPE, PHOTO
  
  // File info
  fileUrl      String
  thumbnailUrl String?
  fileSize     Int      // in bytes
  mimeType     String
  
  // Dimensions
  width        Int?
  height       Int?
  
  // Metadata
  tags         String[] @default([])
  isPublic     Boolean  @default(false)
  
  createdAt    DateTime @default(now())
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([type])
  @@map("design_assets")
}

// BrandKit model (user's brand colors and fonts)
model BrandKit {
  id          String   @id @default(cuid())
  userId      String   @unique

  // Brand colors (array of hex colors)
  colors      String[] @default([])

  // Brand fonts
  primaryFont   String?  @default("Inter")
  secondaryFont String?  @default("Montserrat")

  // Logo
  logoUrl     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("brand_kits")
}

// ========================================
// AI IMAGE GENERATION MODELS
// ========================================

// AIImage model (AI-generated images)
model AIImage {
  id              String   @id @default(cuid())
  userId          String

  // Prompts
  prompt          String   @db.Text
  negativePrompt  String?  @db.Text

  // Model and settings
  model           String   // DALLE3, DALLE2, MIDJOURNEY, STABLE_DIFFUSION
  style           String?  // REALISTIC, ARTISTIC, ANIME, DIGITAL_ART, PHOTOGRAPHIC, etc.
  size            String   // 1024x1024, 1024x1792, 1792x1024, etc.

  // Advanced settings
  steps           Int?     // For Stable Diffusion (20-50)
  cfgScale        Float?   // For Stable Diffusion (7-15)
  seed            String?  // For reproducibility

  // Results
  imageUrl        String?
  thumbnailUrl    String?

  // Status
  status          String   @default("GENERATING") // GENERATING, COMPLETED, FAILED
  errorMessage    String?  @db.Text

  // Metadata
  isPublic        Boolean  @default(false)
  usedInDesign    Boolean  @default(false)
  downloadCount   Int      @default(0)

  generatedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([model])
  @@index([style])
  @@index([isPublic])
  @@index([createdAt])
  @@map("ai_images")
}

// AIImageStyle model (style presets)
model AIImageStyle {
  id              String   @id @default(cuid())
  name            String
  description     String?  @db.Text

  // Visual
  thumbnailUrl    String?
  category        String   // realistic, artistic, digital, 3d, etc.

  // Prompt modifiers
  promptModifier  String   @db.Text  // Text to append to user prompts
  negativePrompt  String?  @db.Text  // Default negative prompt

  // Model preferences
  model           String   // DALLE3, DALLE2, STABLE_DIFFUSION, etc.
  settings        Json?    // Additional settings as JSON

  // Metadata
  isPublic        Boolean  @default(true)
  isPremium       Boolean  @default(false)  // Requires BADASS tier
  usageCount      Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([isPublic])
  @@index([isPremium])
  @@map("ai_image_styles")
}

// ========================================
// VIDEO EDITOR & REPURPOSING MODELS
// ========================================

// Video model (uploaded videos)
model Video {
  id              String   @id @default(cuid())
  userId          String

  // Metadata
  title           String
  description     String?  @db.Text

  // Files
  originalUrl     String
  processedUrl    String?
  thumbnailUrl    String?

  // Video properties
  duration        Int      // in seconds
  width           Int
  height          Int
  fileSize        Int      // in bytes
  format          String?  // MP4, MOV, AVI

  // Status
  status          String   @default("UPLOADING") // UPLOADING, PROCESSING, READY, FAILED
  errorMessage    String?  @db.Text

  // Timestamps
  uploadedAt      DateTime @default(now())
  processedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  clips           VideoClip[]
  transcript      VideoTranscript?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("videos")
}

// VideoClip model (extracted clips)
model VideoClip {
  id              String   @id @default(cuid())
  videoId         String
  userId          String

  // Metadata
  title           String
  description     String?  @db.Text

  // Timing
  startTime       Float    // in seconds
  endTime         Float    // in seconds
  duration        Float    // in seconds

  // Files
  clipUrl         String?
  thumbnailUrl    String?

  // Format
  aspectRatio     String   // 16:9, 9:16, 1:1, 4:5
  width           Int
  height          Int

  // Captions
  captions        Json?    // Subtitle data with timing

  // Status
  status          String   @default("PROCESSING") // PROCESSING, READY, FAILED
  errorMessage    String?  @db.Text

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([videoId])
  @@index([status])
  @@map("video_clips")
}

// VideoTemplate model (platform-specific templates)
model VideoTemplate {
  id              String   @id @default(cuid())
  name            String
  platform        String   // YOUTUBE_SHORT, INSTAGRAM_REEL, TIKTOK, LINKEDIN

  // Format specs
  aspectRatio     String   // 16:9, 9:16, 1:1, 4:5
  maxDuration     Int      // in seconds
  recommendedWidth  Int
  recommendedHeight Int

  // Styling
  captionStyle    Json     // Font, color, position, animation
  overlays        Json?    // Logo, CTA positions

  // Metadata
  thumbnailUrl    String?
  description     String?  @db.Text
  isPublic        Boolean  @default(true)
  usageCount      Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([platform])
  @@index([isPublic])
  @@map("video_templates")
}

// VideoTranscript model (speech-to-text)
model VideoTranscript {
  id              String   @id @default(cuid())
  videoId         String   @unique

  // Transcript data
  fullText        String   @db.Text
  segments        Json     // Timestamped words/phrases
  language        String   @default("en")

  // Metadata
  generatedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@map("video_transcripts")
}

// ========================================
// ANALYTICS DASHBOARD MODELS
// ========================================

// AnalyticsEvent model (raw events)
model AnalyticsEvent {
  id              String   @id @default(cuid())
  userId          String?

  // Event details
  eventType       String   // page_view, feature_use, conversion, etc.
  eventCategory   String   // PAGE_VIEW, FEATURE_USE, CONVERSION, ENGAGEMENT, REVENUE
  eventData       Json?    // Flexible data storage

  // Session info
  sessionId       String
  deviceType      String?  // desktop, mobile, tablet
  browser         String?
  os              String?

  // Location
  ipAddress       String?
  country         String?
  city            String?

  // Traffic source
  referrer        String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?

  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([eventCategory])
  @@index([sessionId])
  @@index([createdAt])
  @@map("analytics_events")
}

// AnalyticsSession model
model AnalyticsSession {
  id              String   @id @default(cuid())
  userId          String?
  sessionId       String   @unique

  // Session timing
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  duration        Int?     // in seconds

  // Activity
  pageViews       Int      @default(0)
  eventsCount     Int      @default(0)

  // Device info
  deviceType      String?
  browser         String?
  os              String?

  // Pages
  entryPage       String?
  exitPage        String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([sessionId])
  @@index([startedAt])
  @@map("analytics_sessions")
}

// AnalyticsMetric model (aggregated daily metrics)
model AnalyticsMetric {
  id              String   @id @default(cuid())
  date            DateTime @db.Date
  metricType      String   // dau, wau, mau, revenue, etc.
  metricValue     Float
  metadata        Json?    // Additional context

  createdAt       DateTime @default(now())

  @@unique([date, metricType])
  @@index([date])
  @@index([metricType])
  @@map("analytics_metrics")
}

// UserActivity model (daily user activity summary)
model UserActivity {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime @db.Date

  // Activity summary
  loginCount      Int      @default(0)
  featuresUsed    String[] @default([])
  timeSpent       Int      @default(0) // in minutes
  actionsCount    Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("user_activities")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// COMMUNITY & FORUM SYSTEM
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// ForumCategory model
model ForumCategory {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?  @db.Text
  icon            String?  // Icon name from lucide-react
  color           String?  // Hex color for category
  order           Int      @default(0)
  isLocked        Boolean  @default(false) // Prevent new threads
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  threads         ForumThread[]
  subscriptions   ForumSubscription[]
  
  @@index([slug])
  @@index([order])
  @@map("forum_categories")
}

// ForumThread model
model ForumThread {
  id              String   @id @default(cuid())
  categoryId      String
  userId          String
  title           String
  slug            String   @unique
  isPinned        Boolean  @default(false)
  isLocked        Boolean  @default(false)
  isFeatured      Boolean  @default(false)
  viewCount       Int      @default(0)
  replyCount      Int      @default(0)
  lastActivityAt  DateTime @default(now())
  lastReplyUserId String?
  tags            String[] @default([])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  category        ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts           ForumPost[]
  subscriptions   ForumSubscription[]
  
  @@index([categoryId])
  @@index([userId])
  @@index([slug])
  @@index([isPinned])
  @@index([isFeatured])
  @@index([lastActivityAt])
  @@map("forum_threads")
}

// ForumPost model
model ForumPost {
  id              String   @id @default(cuid())
  threadId        String
  userId          String
  content         String   @db.Text // Rich text content
  isFirstPost     Boolean  @default(false) // Thread starter post
  editedAt        DateTime?
  editedByUserId  String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  thread          ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions       ForumReaction[]
  reports         ForumReport[]
  
  @@index([threadId])
  @@index([userId])
  @@index([createdAt])
  @@map("forum_posts")
}

// ForumReaction model
model ForumReaction {
  id              String   @id @default(cuid())
  postId          String
  userId          String
  reactionType    String   // HELPFUL, LOVE, CELEBRATE, SPARK, ROCKSTAR
  
  createdAt       DateTime @default(now())
  
  post            ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([postId, userId, reactionType])
  @@index([postId])
  @@index([userId])
  @@map("forum_reactions")
}

// UserReputation model
model UserReputation {
  id              String   @id @default(cuid())
  userId          String   @unique
  points          Int      @default(0)
  level           String   @default("NEWBIE") // NEWBIE, CONTRIBUTOR, EXPERT, ROCKSTAR
  postsCount      Int      @default(0)
  threadsCount    Int      @default(0)
  helpfulCount    Int      @default(0) // Times received "helpful" reaction
  badges          String[] @default([]) // Array of badge IDs
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([points])
  @@index([level])
  @@map("user_reputation")
}

// ForumSubscription model
model ForumSubscription {
  id              String   @id @default(cuid())
  userId          String
  threadId        String?
  categoryId      String?
  subscriptionType String  // THREAD or CATEGORY
  
  createdAt       DateTime @default(now())
  
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread          ForumThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  category        ForumCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  @@unique([userId, threadId])
  @@unique([userId, categoryId])
  @@index([userId])
  @@index([threadId])
  @@index([categoryId])
  @@map("forum_subscriptions")
}

// ForumReport model
model ForumReport {
  id              String   @id @default(cuid())
  postId          String
  reportedByUserId String
  reason          String   // SPAM, INAPPROPRIATE, OFF_TOPIC, HARASSMENT
  details         String?  @db.Text
  status          String   @default("PENDING") // PENDING, REVIEWED, ACTIONED, DISMISSED
  reviewedByAdminId String?
  reviewedAt      DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  post            ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reportedBy      User @relation(fields: [reportedByUserId], references: [id], onDelete: Cascade)
  
  @@index([postId])
  @@index([reportedByUserId])
  @@index([status])
  @@map("forum_reports")
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// E-COMMERCE & PRODUCTS SYSTEM
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// Product model
model Product {
  id              String   @id @default(cuid())
  userId          String
  name            String
  slug            String   @unique
  description     String?  @db.Text
  price           Float
  currency        String   @default("GBP") // GBP, USD, EUR
  productType     String   @default("DIGITAL") // DIGITAL, PHYSICAL, SUBSCRIPTION, SERVICE
  category        String?
  tags            String[] @default([])
  thumbnail       String?
  images          String[] @default([])
  downloadUrl     String?  // For digital products
  fileSize        Int?     // In bytes
  fileType        String?
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  salesCount      Int      @default(0)
  revenue         Float    @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  variants        ProductVariant[]
  orders          Order[]
  reviews         ProductReview[]
  
  @@index([userId])
  @@index([slug])
  @@index([category])
  @@index([isActive])
  @@index([isFeatured])
  @@map("products")
}

// ProductVariant model (for products with options)
model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  name            String
  price           Float
  sku             String?  @unique
  stock           Int?     // For physical products
  isActive        Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders          Order[]
  
  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

// Order model
model Order {
  id              String   @id @default(cuid())
  buyerId         String?  // Can be null for guest checkout
  sellerId        String
  productId       String
  variantId       String?
  quantity        Int      @default(1)
  unitPrice       Float
  totalAmount     Float
  currency        String   @default("GBP")
  status          String   @default("PENDING") // PENDING, PAID, COMPLETED, REFUNDED, FAILED
  paymentIntentId String?  @unique // Stripe payment intent ID
  customerEmail   String
  customerName    String?
  downloadUrl     String?
  downloadExpiresAt DateTime?
  downloadCount   Int      @default(0)
  maxDownloads    Int      @default(5)
  paidAt          DateTime?
  completedAt     DateTime?
  refundedAt      DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  buyer           User? @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: SetNull)
  seller          User @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  
  @@index([buyerId])
  @@index([sellerId])
  @@index([productId])
  @@index([status])
  @@index([paymentIntentId])
  @@map("orders")
}

// Cart model
model Cart {
  id              String   @id @default(cuid())
  userId          String?  // Null for guest carts
  sessionId       String?  // For guest users
  items           Json     // Array of cart items
  totalAmount     Float    @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([sessionId])
  @@map("carts")
}

// ProductReview model
model ProductReview {
  id              String   @id @default(cuid())
  productId       String
  userId          String
  rating          Int      // 1-5
  review          String?  @db.Text
  isVerifiedPurchase Boolean @default(false)
  helpfulCount    Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([rating])
  @@map("product_reviews")
}

// Coupon model
model Coupon {
  id              String   @id @default(cuid())
  userId          String
  code            String   @unique
  discountType    String   // PERCENTAGE, FIXED_AMOUNT
  discountValue   Float
  minPurchaseAmount Float? // Minimum purchase to apply coupon
  maxUses         Int?     // Maximum total uses (null = unlimited)
  usedCount       Int      @default(0)
  expiresAt       DateTime?
  isActive        Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([code])
  @@index([isActive])
  @@map("coupons")
}

// PayoutRequest model
model PayoutRequest {
  id              String   @id @default(cuid())
  userId          String
  amount          Float
  currency        String   @default("GBP")
  status          String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  payoutMethod    String   // STRIPE, PAYPAL, BANK
  payoutDetails   Json?    // Store payout account details
  requestedAt     DateTime @default(now())
  processedAt     DateTime?
  failureReason   String?  @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
  @@map("payout_requests")
}

