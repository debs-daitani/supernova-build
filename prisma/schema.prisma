// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User roles enum
enum UserRole {
  FREE
  UPGRADE
  MEMBER
  ADMIN
}

// Subscription tier enum
enum SubscriptionTier {
  NONE
  UPGRADE_ONE_TIME
  MONTHLY
  ANNUAL
}

// Subscription status enum
enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PENDING
}

// Pillar types enum
enum Pillar {
  BODY
  BRAIN
  BUSINESS
  GENERAL
}

// Content type enum
enum ContentType {
  VIDEO
  TEXT
  AUDIO
  TEMPLATE
  PDF
}

// Marketplace listing status enum
enum ListingStatus {
  DRAFT
  PUBLISHED
  SOLD
}

// Payment type enum
enum PaymentType {
  UPGRADE
  MONTHLY
  ANNUAL
  MARKETPLACE
}

// Payment status enum
enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  DISPUTED
  REFUNDED
}

// Memory type enum
enum MemoryType {
  FACT
  PREFERENCE
  GOAL
  CONTEXT
}

// Social media platform enum
enum SocialPlatform {
  TWITTER
  INSTAGRAM
  TIKTOK
  YOUTUBE
  LINKEDIN
  FACEBOOK
}

// Viral content type enum
enum ViralContentType {
  POST
  VIDEO
  REEL
  THREAD
  ARTICLE
  CAROUSEL
  STORY
  SHORT
}

// Hook type enum
enum HookType {
  QUESTION
  BOLD_CLAIM
  STORY
  STATISTIC
  CONTROVERSY
  CURIOSITY_GAP
  PATTERN_INTERRUPT
  PERSONAL_EXPERIENCE
  LISTICLE
  HOW_TO
}

// Emotional trigger enum
enum EmotionalTrigger {
  SURPRISE
  ANGER
  JOY
  FEAR
  INSPIRATION
  NOSTALGIA
  FOMO
  VALIDATION
  CURIOSITY
  EMPATHY
}

// Content pattern type enum
enum ContentPatternType {
  HOOK
  FORMAT
  STRUCTURE
  TOPIC
  STYLE
  TIMING
}

// Trend status enum
enum TrendStatus {
  RISING
  PEAK
  DECLINING
  DEAD
}

// Content idea status enum
enum ContentIdeaStatus {
  IDEA
  DRAFTED
  SCHEDULED
  PUBLISHED
}

// Source content type enum
enum SourceContentType {
  VIDEO
  PODCAST
  BLOG_POST
  WEBINAR
  INTERVIEW
  PRESENTATION
  EBOOK
  ARTICLE
}

// Repurposed output type enum
enum RepurposedOutputType {
  SHORT_VIDEO
  INSTAGRAM_REEL
  TIKTOK
  YOUTUBE_SHORT
  TWITTER_VIDEO
  LINKEDIN_VIDEO
  FACEBOOK_VIDEO
  PINTEREST_VIDEO
  TWITTER_THREAD
  LINKEDIN_POST
  INSTAGRAM_CAROUSEL
  QUOTE_GRAPHIC
  AUDIOGRAM
  BLOG_SUMMARY
  EMAIL
  EMAIL_SERIES
  LINKEDIN_ARTICLE
  MEDIUM_ARTICLE
  INFOGRAPHIC
  SLIDE_DECK
  STORY_FRAME
  QUOTE_LIST
  FAQ
  TRANSCRIPT
  SHOW_NOTES
  COURSE_MODULE
  HOW_TO_GUIDE
}

// Repurposed content status enum
enum RepurposedContentStatus {
  DRAFT
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
}

// Processing status enum
enum ProcessingStatus {
  QUEUED
  PROCESSING
  READY
  ERROR
}

// Code assistant access level enum
enum CodeAssistantLevel {
  LOCKED
  LANDING_PAGE
  MULTI_PAGE
  FULL_BUSINESS
  ALL_IN_ROCKSTAR
}

// Code language enum
enum CodeLanguage {
  JAVASCRIPT
  HTML
  CSS
  PYTHON
  TYPESCRIPT
  SQL
  JSON
}

// Code deployment type enum
enum CodeDeploymentType {
  WIDGET
  PAGE
  INTEGRATION
  COMPONENT
  SCRIPT
  STYLE
}

// Code generation status enum
enum CodeGenerationStatus {
  DRAFT
  PREVIEW
  DEPLOYED
  ARCHIVED
}

// Code snippet category enum
enum CodeSnippetCategory {
  CALCULATOR
  FORM
  ANIMATION
  INTEGRATION
  TIMER
  GALLERY
  CHART
  WIDGET
  UTILITY
  OTHER
}

// Code template difficulty enum
enum CodeTemplateDifficulty {
  BASIC
  INTERMEDIATE
  ADVANCED
  EXPERT
}

// ============================================
// USERS & AUTHENTICATION
// ============================================

model User {
  id                    String              @id @default(cuid())
  email                 String              @unique
  passwordHash          String
  name                  String?
  role                  UserRole            @default(FREE)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  emailVerified         Boolean             @default(false)
  lastLogin             DateTime?

  // Subscription fields
  subscriptionStatus    SubscriptionStatus  @default(PENDING)
  subscriptionTier      SubscriptionTier    @default(NONE)
  subscriptionEndDate   DateTime?
  stripeCustomerId      String?             @unique

  // Quiz results (stored as JSON)
  quizResults           Json?

  // Profile fields
  bio                   String?
  location              String?
  niche                 String?
  skills                String[]
  socialLinks           Json?
  avatar                String?

  // Relations
  conversations         Conversation[]
  messages              Message[]
  userMemories          UserMemory[]
  payments              Payment[]
  contentProgress       ContentProgress[]

  // Marketplace
  marketplaceListings   MarketplaceListing[] @relation("SellerListings")
  marketplaceMessages   MarketplaceMessage[] @relation("MessageSender")
  marketplacePurchases  MarketplaceTransaction[] @relation("Buyer")
  marketplaceSales      MarketplaceTransaction[] @relation("Seller")
  marketplaceReviews    MarketplaceReview[] @relation("Reviewer")

  // Community
  communityPosts        CommunityPost[]
  communityComments     CommunityComment[]
  communityLikes        CommunityLike[]
  directMessages        DirectMessage[] @relation("DMSender")

  // Viral Content Analyzer
  viralContent          ViralContent[] @relation("UserViralContent")
  contentSubmissions    UserContentSubmission[] @relation("UserContentSubmissions")
  contentIdeas          ContentIdea[] @relation("UserContentIdeas")

  // Content Repurposer
  sourceContent         SourceContent[] @relation("UserSourceContent")
  repurposedContent     RepurposedContent[] @relation("UserRepurposedContent")
  repurposingJobs       RepurposingJob[] @relation("UserRepurposingJobs")
  contentCalendars      ContentCalendar[] @relation("UserContentCalendars")

  // Code Assistant
  codeAccess            CodeAssistantAccess?
  codeConversations     CodeConversation[] @relation("UserCodeConversations")
  codeSnippets          CodeSnippet[] @relation("UserCodeSnippets")
  codeDeployments       CodeDeployment[] @relation("UserCodeDeployments")

  @@index([email])
  @@index([role])
  @@index([subscriptionStatus])
}

// ============================================
// SUPERNOVA AI - CONVERSATIONS & MESSAGES
// ============================================

model Conversation {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  title             String      @default("New Conversation")
  pillar            Pillar?
  archived          Boolean     @default(false)
  folderId          String?
  folder            Folder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  lastMessageAt     DateTime    @default(now())

  // Relations
  messages          Message[]
  userMemories      UserMemory[]

  @@index([userId])
  @@index([userId, archived])
  @@index([userId, lastMessageAt])
  @@index([folderId])
}

model Message {
  id                String        @id @default(cuid())
  conversationId    String
  conversation      Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  role              String        // 'user' or 'assistant'
  content           String        @db.Text

  createdAt         DateTime      @default(now())
  tokensUsed        Int?
  modelUsed         String?

  @@index([conversationId])
  @@index([userId])
  @@index([createdAt])
}

model Folder {
  id                String          @id @default(cuid())
  userId            String
  name              String
  color             String?
  order             Int             @default(0)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  conversations     Conversation[]

  @@index([userId])
}

// ============================================
// SUPERNOVA AI - USER MEMORY
// ============================================

model UserMemory {
  id                    String        @id @default(cuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  memoryType            MemoryType
  content               String        @db.Text

  sourceConversationId  String?
  sourceConversation    Conversation? @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)

  importanceScore       Float         @default(0.5)
  pillarTags            Pillar[]

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([userId])
  @@index([userId, memoryType])
  @@index([importanceScore])
}

// ============================================
// CONTENT LIBRARY
// ============================================

model ContentLibrary {
  id                String          @id @default(cuid())
  title             String
  description       String?         @db.Text
  contentType       ContentType
  pillar            Pillar
  tags              String[]
  fileUrl           String?

  accessLevel       UserRole        @default(MEMBER)
  orderIndex        Int             @default(0)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  progress          ContentProgress[]

  @@index([pillar])
  @@index([accessLevel])
  @@index([orderIndex])
}

model ContentProgress {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  contentId         String
  content           ContentLibrary  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  completed         Boolean         @default(false)
  progress          Float           @default(0)
  lastAccessedAt    DateTime        @default(now())

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
}

// ============================================
// i•DEA MARKETPLACE
// ============================================

model MarketplaceListing {
  id                String              @id @default(cuid())
  sellerId          String
  seller            User                @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Cascade)

  title             String
  description       String              @db.Text
  niche             String

  whatsIncluded     Json                // Array of items (domain, social, email list, etc.)
  whatsNeeded       String?             @db.Text

  progress          Float               @default(0)
  price             Float

  images            String[]
  status            ListingStatus       @default(DRAFT)

  viewsCount        Int                 @default(0)
  featured          Boolean             @default(false)

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  messages          MarketplaceMessage[]
  transactions      MarketplaceTransaction[]
  reviews           MarketplaceReview[]

  @@index([sellerId])
  @@index([status])
  @@index([featured])
  @@index([niche])
  @@index([price])
}

model MarketplaceMessage {
  id                String              @id @default(cuid())
  ideaId            String
  idea              MarketplaceListing  @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  senderId          String
  sender            User                @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId        String
  message           String              @db.Text

  read              Boolean             @default(false)
  createdAt         DateTime            @default(now())

  @@index([ideaId])
  @@index([senderId])
  @@index([receiverId])
  @@index([read])
}

model MarketplaceTransaction {
  id                String              @id @default(cuid())
  ideaId            String
  idea              MarketplaceListing  @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  buyerId           String
  buyer             User                @relation("Buyer", fields: [buyerId], references: [id], onDelete: Cascade)

  sellerId          String
  seller            User                @relation("Seller", fields: [sellerId], references: [id], onDelete: Cascade)

  amount            Float
  commission        Float               // 6% platform commission

  stripePaymentId   String?
  status            PaymentStatus       @default(PENDING)

  createdAt         DateTime            @default(now())
  completedAt       DateTime?

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model MarketplaceReview {
  id                String              @id @default(cuid())
  ideaId            String
  idea              MarketplaceListing  @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  reviewerId        String
  reviewer          User                @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  rating            Int                 // 1-5 stars
  reviewText        String?             @db.Text

  createdAt         DateTime            @default(now())

  @@index([ideaId])
  @@index([reviewerId])
}

// ============================================
// COMMUNITY / THE VENUE
// ============================================

model CommunityPost {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  pillar            Pillar              @default(GENERAL)
  title             String
  content           String              @db.Text

  likesCount        Int                 @default(0)
  commentsCount     Int                 @default(0)

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  comments          CommunityComment[]
  likes             CommunityLike[]

  @@index([userId])
  @@index([pillar])
  @@index([createdAt])
}

model CommunityComment {
  id                String              @id @default(cuid())
  postId            String
  post              CommunityPost       @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  content           String              @db.Text
  parentCommentId   String?

  createdAt         DateTime            @default(now())

  @@index([postId])
  @@index([userId])
}

model CommunityLike {
  id                String              @id @default(cuid())
  postId            String
  post              CommunityPost       @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime            @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model DirectMessage {
  id                String              @id @default(cuid())
  senderId          String
  sender            User                @relation("DMSender", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId        String
  content           String              @db.Text

  read              Boolean             @default(false)
  createdAt         DateTime            @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([read])
}

// ============================================
// PAYMENTS
// ============================================

model Payment {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount            Float
  type              PaymentType

  stripePaymentId   String?
  status            PaymentStatus       @default(PENDING)

  createdAt         DateTime            @default(now())

  @@index([userId])
  @@index([status])
  @@index([type])
}

// ============================================
// VIRAL CONTENT ANALYZER
// ============================================

model ViralContent {
  id                  String              @id @default(cuid())
  userId              String?
  user                User?               @relation("UserViralContent", fields: [userId], references: [id], onDelete: SetNull)

  platform            SocialPlatform
  url                 String              @unique
  author              String
  authorFollowers     Int?
  contentType         ViralContentType

  title               String?
  caption             String?             @db.Text
  transcript          String?             @db.Text
  hashtags            String[]
  mentions            String[]

  publishedAt         DateTime?
  discoveredAt        DateTime            @default(now())

  // Engagement metrics
  views               Int?
  likes               Int?
  comments            Int?
  shares              Int?
  saves               Int?
  engagementRate      Float?
  viralScore          Float               @default(0) // 0-100

  // Classification
  topic               String?
  industry            String?

  // Analysis data stored as JSON
  analysisData        Json?

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  // Relations
  analyses            ViralAnalysis[]
  patterns            ContentPattern[]    @relation("PatternExamples")
  trends              ViralTrend[]        @relation("TrendExamples")

  @@index([platform])
  @@index([viralScore])
  @@index([topic])
  @@index([industry])
  @@index([publishedAt])
  @@index([userId])
}

model ViralAnalysis {
  id                      String                  @id @default(cuid())
  viralContentId          String
  viralContent            ViralContent            @relation(fields: [viralContentId], references: [id], onDelete: Cascade)

  // Hook analysis
  hookType                HookType?
  hookText                String?                 @db.Text
  hookEffectivenessScore  Float?

  // Emotional triggers (stored as array)
  emotionalTriggers       EmotionalTrigger[]

  // Structural elements (stored as JSON)
  structuralElements      Json?

  // Analysis details
  lengthAnalysis          Json?
  timingAnalysis          Json?
  visualElements          Json?
  callToAction            String?                 @db.Text
  engagementDrivers       Json?
  psychologicalPrinciples String[]

  // Recommendations (stored as JSON)
  recommendations         Json?

  createdAt               DateTime                @default(now())

  @@index([viralContentId])
  @@index([hookType])
}

model ContentPattern {
  id                  String                @id @default(cuid())

  platform            SocialPlatform
  patternType         ContentPatternType
  pattern             String                @db.Text

  exampleCount        Int                   @default(0)
  avgEngagementRate   Float?

  description         String                @db.Text
  howToUse            String                @db.Text

  // Examples stored as JSON with references
  examples            ViralContent[]        @relation("PatternExamples")

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  // Relations
  contentIdeas        ContentIdea[]

  @@index([platform])
  @@index([patternType])
  @@index([avgEngagementRate])
}

model UserContentSubmission {
  id                  String              @id @default(cuid())
  userId              String
  user                User                @relation("UserContentSubmissions", fields: [userId], references: [id], onDelete: Cascade)

  platform            SocialPlatform
  url                 String
  contentType         ViralContentType

  // User's performance metrics
  yourViews           Int?
  yourLikes           Int?
  yourComments        Int?
  yourShares          Int?
  yourSaves           Int?
  yourEngagementRate  Float?

  // Analysis status
  analysisRequested   Boolean             @default(true)
  analysisCompleted   Boolean             @default(false)

  // Analysis results (stored as JSON)
  analysis            Json?
  recommendations     Json?
  comparisonData      Json? // Comparison with similar viral content

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([userId])
  @@index([platform])
  @@index([analysisCompleted])
}

model ContentIdea {
  id                  String                @id @default(cuid())
  userId              String
  user                User                  @relation("UserContentIdeas", fields: [userId], references: [id], onDelete: Cascade)

  platform            SocialPlatform
  idea                String                @db.Text

  basedOnPatternId    String?
  basedOnPattern      ContentPattern?       @relation(fields: [basedOnPatternId], references: [id], onDelete: SetNull)

  hook                String?               @db.Text
  structure           Json?
  estimatedViralScore Float?
  tags                String[]

  status              ContentIdeaStatus     @default(IDEA)

  // Draft content
  draftContent        String?               @db.Text
  scheduledFor        DateTime?
  publishedAt         DateTime?
  publishedUrl        String?

  // Actual performance (if published and tracked)
  actualViralScore    Float?
  actualEngagement    Json?

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([userId])
  @@index([platform])
  @@index([status])
  @@index([estimatedViralScore])
}

model ViralTrend {
  id                  String              @id @default(cuid())

  platform            SocialPlatform
  trend               String
  category            String?

  startDate           DateTime
  peakDate            DateTime?
  endDate             DateTime?

  status              TrendStatus         @default(RISING)

  // Example content references
  exampleContent      ViralContent[]      @relation("TrendExamples")

  howToCapitalize     String?             @db.Text

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([platform])
  @@index([status])
  @@index([category])
  @@index([peakDate])
}

// ============================================
// CONTENT REPURPOSER
// ============================================

model SourceContent {
  id                  String              @id @default(cuid())
  userId              String
  user                User                @relation("UserSourceContent", fields: [userId], references: [id], onDelete: Cascade)

  title               String
  contentType         SourceContentType
  sourceFile          String?             // URL or file path
  sourceUrl           String?             // Original URL if from web

  // Content metrics
  duration            Int?                // In seconds (for video/audio)
  wordCount           Int?                // For text content
  fileSize            Int?                // In bytes

  // AI-extracted data
  transcript          String?             @db.Text
  keyTopics           Json?               // Array of topics
  keyMoments          Json?               // Array of {timestamp, description, importance}
  quotes              Json?               // Array of quotable moments
  speakers            Json?               // Array of speaker names/IDs
  chapters            Json?               // Array of chapter markers
  sentiment           Json?               // Sentiment analysis data

  // Processing status
  status              ProcessingStatus    @default(QUEUED)
  processingError     String?             @db.Text
  processedAt         DateTime?

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  // Relations
  repurposedContent   RepurposedContent[]
  repurposingJobs     RepurposingJob[]

  @@index([userId])
  @@index([status])
  @@index([contentType])
  @@index([createdAt])
}

model RepurposedContent {
  id                  String                    @id @default(cuid())
  userId              String
  user                User                      @relation("UserRepurposedContent", fields: [userId], references: [id], onDelete: Cascade)

  sourceContentId     String
  sourceContent       SourceContent             @relation(fields: [sourceContentId], references: [id], onDelete: Cascade)

  repurposingJobId    String?
  repurposingJob      RepurposingJob?           @relation(fields: [repurposingJobId], references: [id], onDelete: SetNull)

  // Output configuration
  outputType          RepurposedOutputType
  platform            SocialPlatform?
  templateId          String?
  template            ContentTemplate?          @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // Content
  title               String?
  content             String?                   @db.Text
  caption             String?                   @db.Text
  hashtags            String[]
  mentions            String[]

  // Media
  mediaUrl            String?                   // Generated media file URL
  thumbnailUrl        String?                   // Thumbnail/preview
  duration            Int?                      // For video/audio outputs

  // Metadata
  metadata            Json?                     // Additional data (dimensions, format, etc.)
  keyMoment           Json?                     // Reference to source moment if applicable

  // Status and publishing
  status              RepurposedContentStatus   @default(DRAFT)
  scheduledFor        DateTime?
  publishedAt         DateTime?
  publishedUrl        String?                   // URL after publishing

  // Performance tracking
  performance         Json?                     // Views, likes, shares, etc.

  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([userId])
  @@index([sourceContentId])
  @@index([repurposingJobId])
  @@index([outputType])
  @@index([platform])
  @@index([status])
  @@index([scheduledFor])
}

model ContentTemplate {
  id                  String                    @id @default(cuid())

  name                String
  description         String?                   @db.Text
  outputType          RepurposedOutputType
  platform            SocialPlatform?

  // Template configuration
  template            Json                      // Structure/format definition
  styleConfig         Json?                     // Colors, fonts, layout
  exampleUrl          String?                   // Example output

  isActive            Boolean                   @default(true)
  isDefault           Boolean                   @default(false)

  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  // Relations
  repurposedContent   RepurposedContent[]

  @@index([outputType])
  @@index([platform])
  @@index([isActive])
}

model RepurposingJob {
  id                  String              @id @default(cuid())
  userId              String
  user                User                @relation("UserRepurposingJobs", fields: [userId], references: [id], onDelete: Cascade)

  sourceContentId     String
  sourceContent       SourceContent       @relation(fields: [sourceContentId], references: [id], onDelete: Cascade)

  // Job configuration
  selectedOutputs     Json                // Array of output types to generate
  config              Json?               // Generation configuration

  // Processing status
  status              ProcessingStatus    @default(QUEUED)
  progress            Int                 @default(0) // 0-100
  currentStep         String?             // Current processing step
  outputsGenerated    Int                 @default(0)
  totalOutputs        Int?

  // Error handling
  errors              Json?               // Array of errors if any

  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime            @default(now())

  // Relations
  repurposedContent   RepurposedContent[]

  @@index([userId])
  @@index([sourceContentId])
  @@index([status])
  @@index([createdAt])
}

model ContentCalendar {
  id                  String              @id @default(cuid())
  userId              String
  user                User                @relation("UserContentCalendars", fields: [userId], references: [id], onDelete: Cascade)

  date                DateTime            @db.Date
  platform            SocialPlatform?

  // Scheduled content
  contentPieces       Json                // Array of RepurposedContent IDs
  notes               String?             @db.Text

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([userId, date, platform])
  @@index([userId])
  @@index([date])
  @@index([platform])
}

// ============================================
// CODE ASSISTANT (INTEGRATED AI DEVELOPER)
// ============================================

model CodeAssistantAccess {
  id                    String                @id @default(cuid())
  userId                String                @unique
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessLevel           CodeAssistantLevel    @default(LOCKED)

  // Website metrics for tier calculation
  websitePageCount      Int                   @default(0)
  platformFeaturesUsed  String[]              // Array of feature names

  // Unlock tracking
  unlockedAt            DateTime?
  lastCheckedAt         DateTime              @default(now())

  // Usage stats
  conversationsCount    Int                   @default(0)
  deploymentsCount      Int                   @default(0)
  linesOfCodeGenerated  Int                   @default(0)

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([userId])
  @@index([accessLevel])
}

model CodeConversation {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation("UserCodeConversations", fields: [userId], references: [id], onDelete: Cascade)

  title             String              @default("New Code Project")
  status            String              @default("active") // active, archived

  totalMessages     Int                 @default(0)

  // Context
  targetPage        String?             // Which page this is for
  projectType       String?             // calculator, form, integration, etc.

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  lastMessageAt     DateTime            @default(now())

  // Relations
  messages          CodeMessage[]
  generations       CodeGeneration[]

  @@index([userId])
  @@index([userId, status])
  @@index([lastMessageAt])
}

model CodeMessage {
  id                String              @id @default(cuid())
  conversationId    String
  conversation      CodeConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role              String              // user, assistant
  content           String              @db.Text

  // Code blocks extracted from message
  codeBlocks        Json?               // Array of {language, code, fileName}

  // Deployment reference
  deploymentId      String?

  timestamp         DateTime            @default(now())

  @@index([conversationId])
  @@index([timestamp])
}

model CodeGeneration {
  id                String                @id @default(cuid())
  conversationId    String
  conversation      CodeConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  messageId         String?               // Reference to message that generated this

  language          CodeLanguage
  code              String                @db.Text
  explanation       String?               @db.Text
  fileName          String?

  status            CodeGenerationStatus  @default(DRAFT)

  // Complexity metrics
  linesOfCode       Int?
  complexity        String?               // basic, intermediate, advanced

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  // Relations
  deployments       CodeDeployment[]
  snippet           CodeSnippet?

  @@index([conversationId])
  @@index([status])
  @@index([language])
}

model CodeDeployment {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation("UserCodeDeployments", fields: [userId], references: [id], onDelete: Cascade)

  generationId      String
  generation        CodeGeneration      @relation(fields: [generationId], references: [id], onDelete: Cascade)

  deploymentType    CodeDeploymentType
  targetPage        String?             // Which page it's deployed to
  targetSection     String?             // Which section (header, footer, etc.)

  isActive          Boolean             @default(true)

  // Version tracking
  version           Int                 @default(1)

  deployedAt        DateTime            @default(now())
  lastModifiedAt    DateTime            @updatedAt

  @@index([userId])
  @@index([generationId])
  @@index([isActive])
  @@index([targetPage])
}

model CodeSnippet {
  id                String                @id @default(cuid())
  userId            String
  user              User                  @relation("UserCodeSnippets", fields: [userId], references: [id], onDelete: Cascade)

  generationId      String?               @unique
  generation        CodeGeneration?       @relation(fields: [generationId], references: [id], onDelete: SetNull)

  title             String
  description       String?               @db.Text
  language          CodeLanguage
  code              String                @db.Text

  category          CodeSnippetCategory   @default(OTHER)
  tags              String[]

  // Sharing
  isPublic          Boolean               @default(false)
  isFavorite        Boolean               @default(false)

  // Usage tracking
  uses              Int                   @default(0)
  lastUsedAt        DateTime?

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([userId])
  @@index([category])
  @@index([isPublic])
  @@index([isFavorite])
}

model CodeTemplate {
  id                String                    @id @default(cuid())

  name              String
  description       String?                   @db.Text
  category          CodeSnippetCategory       @default(OTHER)

  code              String                    @db.Text
  language          CodeLanguage              @default(JAVASCRIPT)

  // Customization
  variables         Json?                     // Variables that can be customized

  difficulty        CodeTemplateDifficulty    @default(BASIC)
  accessLevel       CodeAssistantLevel        @default(LANDING_PAGE) // Which tier can use it

  exampleUrl        String?                   // Preview/demo URL
  previewImage      String?                   // Thumbnail

  isActive          Boolean                   @default(true)
  isFeatured        Boolean                   @default(false)

  // Usage stats
  usageCount        Int                       @default(0)

  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([category])
  @@index([difficulty])
  @@index([accessLevel])
  @@index([isActive])
  @@index([isFeatured])
}
