// ============================================
// FINANCE MODULE
// ============================================

model FinanceIncome {
  id                 String    @id @default(cuid())
  userId             String
  amount             Float
  source             String
  category           String
  date               DateTime
  notes              String?
  contactId          String?
  isRecurring        Boolean   @default(false)
  recurringFrequency String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, date])
  @@index([userId, category])
}

model FinanceExpense {
  id                 String   @id @default(cuid())
  userId             String
  amount             Float
  vendor             String
  category           String
  date               DateTime
  notes              String?
  isRecurring        Boolean  @default(false)
  recurringFrequency String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@index([userId, category])
}

model FinanceInvoice {
  id            String   @id @default(cuid())
  userId        String
  contactId     String?
  prefixId      String?
  invoiceNumber String
  status        String   @default("DRAFT")
  issueDate     DateTime
  dueDate       DateTime
  subtotal      Float
  tax           Float?
  total         Float
  notes         String?
  lineItems     Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  prefix  InvoicePrefix?  @relation(fields: [prefixId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, status])
  @@index([invoiceNumber])
  @@index([prefixId])
}

model InvoicePrefix {
  id          String   @id @default(cuid())
  userId      String
  name        String   // "Coaching", "Pet Business"
  prefix      String   // "DD", "PET"
  nextNumber  Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices FinanceInvoice[]

  @@unique([userId, prefix])
  @@index([userId])
}

// ============================================
// CALENDAR MODULE
// ============================================

model CalendarConnection {
  id            String   @id @default(cuid())
  userId        String   @unique
  provider      String   @default("google")
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  calendarIds   Json?    // Which calendars to sync
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CalendarEvent {
  id              String    @id @default(cuid())
  userId          String
  externalId      String?   // Google Calendar event ID
  title           String
  description     String?
  startTime       DateTime
  endTime         DateTime
  allDay          Boolean   @default(false)
  location        String?
  colour          String?
  isRecurring     Boolean   @default(false)
  recurrenceRule  String?   // RRULE format
  contactId       String?   // Link to CRM contact
  venuedTaskId    String?   // Link to VENUED task
  source          String    @default("manual") // manual, google, venued
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, startTime])
  @@index([userId, source])
  @@index([externalId])
}

// ============================================
// SOCIAL MEDIA MODULE
// ============================================

model SocialAccount {
  id            String    @id @default(cuid())
  userId        String
  platform      String    // instagram, facebook, linkedin, tiktok
  accountId     String    // Platform's account ID
  accountName   String    // Display name
  accessToken   String
  refreshToken  String?
  expiresAt     DateTime?
  profileImage  String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts SocialPost[] @relation("SocialAccountPosts")

  @@unique([userId, platform, accountId])
  @@index([userId])
  @@index([userId, platform])
}

model SocialPost {
  id            String    @id @default(cuid())
  userId        String
  content       String
  mediaUrls     Json?     // Array of image/video URLs
  platforms     Json      // Array of platform names to post to
  status        String    @default("draft") // draft, scheduled, published, failed
  scheduledFor  DateTime?
  publishedAt   DateTime?
  externalIds   Json?     // {instagram: "123", facebook: "456"}
  analytics     Json?     // {likes: 10, comments: 5, shares: 2}
  errorMessage  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts SocialAccount[] @relation("SocialAccountPosts")

  @@index([userId])
  @@index([userId, status])
  @@index([userId, scheduledFor])
}
