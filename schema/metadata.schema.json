{
  "collectionName": "SupernovaMetadata",
  "displayName": "Supernova Metadata",
  "permissions": {
    "read": "Admin",
    "write": "Admin",
    "delete": "Admin"
  },
  "fields": [
    {
      "name": "_id",
      "type": "text",
      "required": true,
      "description": "Auto-generated unique identifier"
    },
    {
      "name": "metadataId",
      "type": "text",
      "required": true,
      "description": "Custom metadata identifier"
    },
    {
      "name": "type",
      "type": "text",
      "required": true,
      "description": "Metadata type (summary, analytics, system)"
    },
    {
      "name": "entityType",
      "type": "text",
      "required": true,
      "description": "Related entity (user, conversation, message)"
    },
    {
      "name": "entityId",
      "type": "text",
      "required": false,
      "description": "Related entity ID"
    },
    {
      "name": "userId",
      "type": "text",
      "required": false,
      "description": "Related user ID (if applicable)"
    },
    {
      "name": "data",
      "type": "object",
      "required": true,
      "description": "Metadata payload"
    },
    {
      "name": "createdAt",
      "type": "date",
      "required": true,
      "description": "Creation timestamp"
    },
    {
      "name": "updatedAt",
      "type": "date",
      "required": false,
      "description": "Last update timestamp"
    },
    {
      "name": "expiresAt",
      "type": "date",
      "required": false,
      "description": "Expiration timestamp (if applicable)"
    }
  ],
  "indexes": [
    {
      "name": "metadataId_unique",
      "fields": ["metadataId"],
      "unique": true
    },
    {
      "name": "type_index",
      "fields": ["type"],
      "unique": false
    },
    {
      "name": "entityType_index",
      "fields": ["entityType"],
      "unique": false
    },
    {
      "name": "entityId_index",
      "fields": ["entityId"],
      "unique": false
    },
    {
      "name": "entityType_entityId_composite",
      "fields": ["entityType", "entityId"],
      "unique": false
    }
  ]
}
