    {
      "key": "viralScore",
      "type": "number",
      "description": "AI-calculated viral score (0-100)"
    },
    {
      "key": "topic",
      "type": "text",
      "description": "Main topic or subject"
    },
    {
      "key": "industry",
      "type": "text",
      "description": "Industry/niche category"
    },
    {
      "key": "thumbnailUrl",
      "type": "text",
      "description": "Thumbnail or preview image URL"
    },
    {
      "key": "analysisData",
      "type": "object",
      "description": "JSON object with detailed analysis results"
    },
    {
      "key": "isAnalyzed",
      "type": "boolean",
      "description": "Whether AI analysis has been completed"
    },
    {
      "key": "isSaved",
      "type": "boolean",
      "description": "Whether user saved this to their library"
    },
    {
      "key": "createdAt",
      "type": "datetime",
      "description": "Record creation timestamp"
    }
