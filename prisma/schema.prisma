generator client {
  provider = "prisma-client-js"
  output   = "../server/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile          UserProfile?
  sessions         Session[]
  passwordResets   PasswordReset[]
  subscription     Subscription?
  conversations    Conversation[]
  memories         Memory[]
  coachingSessions CoachingSession[]
  context          Context?
  userProgress     UserProgress[]

  @@index([email])
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName            String
  preferredName       String
  pronouns            String?
  communicationStyle  String?
  onboardingCompleted Boolean  @default(false)
  firstInteractionAt  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model SubscriptionTier {
  id          String   @id @default(cuid())
  name        String   @unique
  price       Float
  currency    String   @default("GBP")
  features    Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]

  @@index([name])
}

model Subscription {
  id               String           @id @default(cuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tierId           String
  tier             SubscriptionTier @relation(fields: [tierId], references: [id])

  status           String           @default("active")

  isVIP            Boolean          @default(false)
  vipStartDate     DateTime?
  vipFreeMonthEnd  DateTime?
  vipHalfPriceEnd  DateTime?

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean        @default(false)

  stripeCustomerId       String?  @unique
  stripeSubscriptionId   String?  @unique
  stripePriceId          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
  addOns   AddOnPurchase[]

  @@index([userId])
  @@index([tierId])
  @@index([status])
}

model Payment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  amount         Float
  currency       String       @default("GBP")
  status         String
  paymentMethod  String?

  stripePaymentIntentId String? @unique
  stripeInvoiceId       String? @unique

  paidAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([subscriptionId])
  @@index([status])
}

model Invoice {
  id             String   @id @default(cuid())
  userId         String

  amount         Float
  currency       String   @default("GBP")
  status         String
  description    String?

  stripeInvoiceId String? @unique
  invoiceUrl      String?
  invoicePdf      String?

  dueDate   DateTime?
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([status])
}

model AddOnPurchase {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  addOnType      String
  price          Float
  currency       String       @default("GBP")
  status         String       @default("active")

  purchasedAt DateTime @default(now())
  expiresAt   DateTime?

  @@index([subscriptionId])
  @@index([addOnType])
}

// SUPERNova AI Models

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  mode      String   @default("general")
  title     String?
  status    String   @default("active")

  lastMessageAt DateTime?
  messageCount  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  sessions CoachingSession[]

  @@index([userId])
  @@index([status])
  @@index([mode])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role           String
  content        String       @db.Text
  metadata       Json?
  tokens         Int?

  timestamp DateTime @default(now())

  @@index([conversationId])
  @@index([timestamp])
}

model Memory {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  category   String
  key        String
  value      String @db.Text
  context    Json?
  importance String @default("medium")

  lastUsed  DateTime?
  useCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([importance])
}

model CoachingSession {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  mode           String
  topic          String?
  duration       Int?
  messagesCount  Int          @default(0)

  keyInsights    Json?
  actionItems    Json?
  progress       Json?

  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([mode])
}

model Context {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?

  platformActivity  Json?
  businessMetrics   Json?
  recentGoals       Json?
  activeChallenges  Json?

  lastRefreshed DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([userId])
}

model CoachingProgram {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String @db.Text
  tier        String

  isActive Boolean @default(true)
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules  ProgramModule[]
  progress UserProgress[]

  @@index([code])
  @@index([tier])
}

model ProgramModule {
  id        String          @id @default(cuid())
  programId String
  program   CoachingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text
  order       Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons ProgramLesson[]

  @@index([programId])
  @@index([order])
}

model ProgramLesson {
  id       String        @id @default(cuid())
  moduleId String
  module   ProgramModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  title       String
  content     String @db.Text
  contentType String @default("text")
  duration    Int?
  order       Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
  @@index([order])
}

model UserProgress {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId String
  program   CoachingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  currentModuleId  String?
  currentLessonId  String?
  completedModules Json?
  completedLessons Json?

  progressPercent Int      @default(0)
  startedAt       DateTime @default(now())
  lastAccessedAt  DateTime @default(now())
  completedAt     DateTime?

  @@unique([userId, programId])
  @@index([userId])
  @@index([programId])
}
