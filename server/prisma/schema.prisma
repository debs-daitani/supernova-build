// PHASE 2AF - PDF EDITOR
// ============================================================================

model PDFDocument {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Document info
  name          String
  originalName  String

  // File
  pdfUrl        String
  fileSize      Int
  pageCount     Int

  // Thumbnail
  thumbnail     String?

  // Editing
  isEdited      Boolean       @default(false)
  editedUrl     String?       // If modified

  // Security
  isProtected   Boolean       @default(false)
  hasPassword   Boolean       @default(false)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  annotations   PDFAnnotation[]
  signatures    PDFSignature[]

  @@index([userId])
}

model PDFAnnotation {
  id            String        @id @default(cuid())
  pdfId         String
  pdf           PDFDocument   @relation(fields: [pdfId], references: [id], onDelete: Cascade)

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Annotation type
  annotationType String       // "comment", "highlight", "underline", "drawing", "text", "stamp"

  // Position
  pageNumber    Int
  position      Json          // {x, y, width, height}

  // Content
  content       String?       @db.Text
  color         String?

  createdAt     DateTime      @default(now())

  @@index([pdfId])
  @@index([userId])
}

model PDFSignature {
  id            String        @id @default(cuid())
  pdfId         String
  pdf           PDFDocument   @relation(fields: [pdfId], references: [id], onDelete: Cascade)

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Signature
  signatureType String        // "drawn", "typed", "image"
  signatureData String        @db.Text  // Base64 image or text

  // Position
  pageNumber    Int
  position      Json

  // Verification
  timestamp     DateTime      @default(now())
  ipAddress     String?

  @@index([pdfId])
  @@index([userId])
}

model PDFTemplate {
  id            String        @id @default(cuid())

  // Template info
  name          String
  description   String?       @db.Text
  category      String        // "contract", "invoice", "form", "certificate", etc.

  // File
  templateUrl   String
  thumbnail     String

  // Fields (if form template)
  fields        Json?         // Form field definitions

  featured      Boolean       @default(false)
  usageCount    Int           @default(0)

  createdAt     DateTime      @default(now())

  @@index([category])
}

// ============================================================================
// PHASE 2AG - DOCUMENT EDITOR
// ============================================================================

model Document {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Document info
  title         String        @default("Untitled Document")

  // Content (stored as JSON - Delta format or ProseMirror)
  content       Json

  // Metadata
  wordCount     Int           @default(0)
  characterCount Int          @default(0)

  // Sharing
  isPublic      Boolean       @default(false)
  shareLink     String?       @unique

  // Folder organization
  folderId      String?
  folder        DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lastViewedAt  DateTime      @default(now())

  // Relations
  collaborators DocumentCollaborator[]
  comments      DocumentComment[]
  versions      DocumentVersion[]

  @@index([userId])
  @@index([folderId])
  @@index([updatedAt])
}

model DocumentFolder {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  color         String?

  parentId      String?
  parent        DocumentFolder? @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders    DocumentFolder[] @relation("FolderHierarchy")

  documents     Document[]

  createdAt     DateTime      @default(now())

  @@index([userId])
  @@index([parentId])
}

model DocumentCollaborator {
  id            String        @id @default(cuid())
  documentId    String
  document      Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Permission level
  permission    String        // "view", "comment", "edit", "owner"

  // Activity
  lastViewedAt  DateTime      @default(now())

  invitedAt     DateTime      @default(now())
  invitedBy     String

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
}

model DocumentComment {
  id            String        @id @default(cuid())
  documentId    String
  document      Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Comment content
  content       String        @db.Text

  // Position in document
  anchor        Json          // {start: index, end: index}

  // Status
  resolved      Boolean       @default(false)
  resolvedAt    DateTime?
  resolvedBy    String?

  // Thread
  parentId      String?
  parent        DocumentComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       DocumentComment[] @relation("CommentReplies")

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([documentId])
  @@index([userId])
  @@index([parentId])
}

model DocumentVersion {
  id            String        @id @default(cuid())
  documentId    String
  document      Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Version info
  versionNumber Int
  content       Json

  // Author
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Metadata
  changesSummary String?      @db.Text

  createdAt     DateTime      @default(now())

  @@index([documentId])
  @@index([userId])
}

model DocumentTemplate {
  id            String        @id @default(cuid())

  name          String
  description   String?       @db.Text
  category      String        // "business", "academic", "personal", "creative"

  content       Json          // Template content
  thumbnail     String?

  featured      Boolean       @default(false)
  usageCount    Int           @default(0)

  createdAt     DateTime      @default(now())

  @@index([category])
}

// ============================================================================
// PHASE 2AH - SPREADSHEET EDITOR
// ============================================================================

model Spreadsheet {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Spreadsheet info
  title         String        @default("Untitled Spreadsheet")

  // Data (stored as JSON - cell data, formulas, formatting)
  sheets        Json          // Array of sheets, each with cells data

  // Sharing
  isPublic      Boolean       @default(false)
  shareLink     String?       @unique

  // Folder
  folderId      String?
  folder        SpreadsheetFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lastViewedAt  DateTime      @default(now())

  // Relations
  collaborators SpreadsheetCollaborator[]
  comments      SpreadsheetComment[]
  versions      SpreadsheetVersion[]

  @@index([userId])
  @@index([folderId])
  @@index([updatedAt])
}

model SpreadsheetFolder {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  color         String?

  parentId      String?
  parent        SpreadsheetFolder? @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders    SpreadsheetFolder[] @relation("FolderHierarchy")

  spreadsheets  Spreadsheet[]

  createdAt     DateTime      @default(now())

  @@index([userId])
  @@index([parentId])
}

model SpreadsheetCollaborator {
  id            String        @id @default(cuid())
  spreadsheetId String
  spreadsheet   Spreadsheet   @relation(fields: [spreadsheetId], references: [id], onDelete: Cascade)

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  permission    String        // "view", "comment", "edit", "owner"

  lastViewedAt  DateTime      @default(now())
  invitedAt     DateTime      @default(now())
  invitedBy     String

  @@unique([spreadsheetId, userId])
  @@index([spreadsheetId])
  @@index([userId])
}

model SpreadsheetComment {
  id            String        @id @default(cuid())
  spreadsheetId String
  spreadsheet   Spreadsheet   @relation(fields: [spreadsheetId], references: [id], onDelete: Cascade)

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  content       String        @db.Text

  // Cell reference
  sheetName     String
  cellReference String        // e.g., "A1", "B5:D10"

  resolved      Boolean       @default(false)
  resolvedAt    DateTime?
  resolvedBy    String?

  parentId      String?
  parent        SpreadsheetComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       SpreadsheetComment[] @relation("CommentReplies")

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([spreadsheetId])
  @@index([userId])
  @@index([parentId])
}

model SpreadsheetVersion {
  id            String        @id @default(cuid())
  spreadsheetId String
  spreadsheet   Spreadsheet   @relation(fields: [spreadsheetId], references: [id], onDelete: Cascade)

  versionNumber Int
  sheets        Json

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  changesSummary String?      @db.Text

  createdAt     DateTime      @default(now())

  @@index([spreadsheetId])
  @@index([userId])
}

model SpreadsheetTemplate {
  id            String        @id @default(cuid())

  name          String
  description   String?       @db.Text
  category      String        // "budget", "invoice", "tracker", "dashboard", "schedule"

  sheets        Json          // Template data
  thumbnail     String?

  featured      Boolean       @default(false)
  usageCount    Int           @default(0)

  createdAt     DateTime      @default(now())

  @@index([category])
}

// ============================================
// Phase 2AI: Presentation Editor (Google Slides Killer)
// ============================================

model Presentation {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String        @default("Untitled Presentation")
  slides        Json          // Array of slide objects
  theme         String        @default("default")
  themeId       String?
  customTheme   PresentationTheme? @relation(fields: [themeId], references: [id], onDelete: SetNull)
  settings      Json?         // Slide size, animations settings, etc.

  isPublic      Boolean       @default(false)
  shareLink     String?       @unique
  folderId      String?
  folder        PresentationFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lastViewedAt  DateTime      @default(now())

  collaborators PresentationCollaborator[]
  comments      PresentationComment[]
  versions      PresentationVersion[]

  @@index([userId])
  @@index([folderId])
  @@index([updatedAt])
}

model PresentationFolder {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  color         String?
  parentId      String?
  parent        PresentationFolder? @relation("PresentationFolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders    PresentationFolder[] @relation("PresentationFolderHierarchy")

  presentations Presentation[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([parentId])
}

model PresentationCollaborator {
  id              String        @id @default(cuid())
  presentationId  String
  presentation    Presentation  @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  permission      String        // "view", "comment", "edit"

  createdAt       DateTime      @default(now())

  @@unique([presentationId, userId])
  @@index([presentationId])
  @@index([userId])
}

model PresentationComment {
  id              String        @id @default(cuid())
  presentationId  String
  presentation    Presentation  @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  slideIndex      Int           // Which slide (0-based)
  content         String        @db.Text
  position        Json?         // {x, y} position on slide

  resolved        Boolean       @default(false)
  resolvedBy      String?
  resolvedAt      DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([presentationId])
  @@index([userId])
}

model PresentationVersion {
  id              String        @id @default(cuid())
  presentationId  String
  presentation    Presentation  @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  versionNumber   Int
  slides          Json          // Snapshot of slides
  theme           String
  settings        Json?

  changesSummary  String?       @db.Text

  createdAt       DateTime      @default(now())

  @@index([presentationId])
  @@index([userId])
}

model PresentationTemplate {
  id            String        @id @default(cuid())

  name          String
  description   String?       @db.Text
  category      String        // "pitch", "business", "education", "marketing", "creative"

  slides        Json          // Template slides
  theme         String        @default("default")
  thumbnail     String?

  featured      Boolean       @default(false)
  usageCount    Int           @default(0)

  createdAt     DateTime      @default(now())

  @@index([category])
}

model PresentationTheme {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  colors        Json          // {primary, secondary, accent, background, text}
  fonts         Json          // {heading, body}
  masterSlides  Json          // Array of master slide layouts

  isPublic      Boolean       @default(false)
  isDefault     Boolean       @default(false)

  presentations Presentation[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
}

// ============================================
// Phase 2AJ: Forms Builder (Google Forms Killer)
// ============================================

model Form {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  description   String?       @db.Text

  questions     Json          // Array of question objects

  isPublished   Boolean       @default(false)
  acceptingResponses Boolean   @default(true)
  requiresLogin Boolean       @default(false)
  allowMultiple Boolean       @default(true)
  shuffleQuestions Boolean    @default(false)

  theme         Json?         // Colors, logo, background

  confirmationMessage String?  @db.Text
  redirectUrl   String?

  emailNotification Boolean   @default(false)
  notificationEmail String?

  folderId      String?
  folder        FormFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)

  shareLink     String?       @unique

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  responses     FormResponse[]

  @@index([userId])
  @@index([folderId])
  @@index([isPublished])
}

model FormFolder {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  color         String?

  parentId      String?
  parent        FormFolder?   @relation("FormFolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders    FormFolder[]  @relation("FormFolderHierarchy")

  forms         Form[]

  createdAt     DateTime      @default(now())

  @@index([userId])
  @@index([parentId])
}

model FormResponse {
  id            String        @id @default(cuid())
  formId        String
  form          Form          @relation(fields: [formId], references: [id], onDelete: Cascade)

  userId        String?
  email         String?

  answers       Json          // {questionId: answer}

  ipAddress     String?
  userAgent     String?
  completionTime Int?         // Seconds

  submittedAt   DateTime      @default(now())

  @@index([formId])
  @@index([userId])
  @@index([submittedAt])
}

model FormTemplate {
  id            String        @id @default(cuid())

  name          String
  description   String?       @db.Text
  category      String        // "survey", "registration", "feedback", "quiz", "contact"

  questions     Json
  theme         Json?
  thumbnail     String?

  featured      Boolean       @default(false)
  usageCount    Int           @default(0)

  createdAt     DateTime      @default(now())

  @@index([category])
}

// ============================================
// Phase 2AK: Cloud Storage (Google Drive Killer)
// ============================================

model StorageFile {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  originalName  String
  mimeType      String
  fileSize      BigInt

  storageUrl    String
  storageKey    String

  folderId      String?
  folder        StorageFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  thumbnailUrl  String?

  isStarred     Boolean       @default(false)
  isTrashed     Boolean       @default(false)
  trashedAt     DateTime?

  isPublic      Boolean       @default(false)
  shareLink     String?       @unique

  documentType  String?       // "doc", "sheet", "presentation", "form"
  documentId    String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lastViewedAt  DateTime      @default(now())

  shares        StorageShare[]
  versions      StorageFileVersion[]

  @@index([userId])
  @@index([folderId])
  @@index([isTrashed])
  @@index([isStarred])
  @@index([mimeType])
}

model StorageFolder {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  color         String?

  parentId      String?
  parent        StorageFolder? @relation("StorageFolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders    StorageFolder[] @relation("StorageFolderHierarchy")

  isStarred     Boolean       @default(false)
  isTrashed     Boolean       @default(false)
  trashedAt     DateTime?

  isPublic      Boolean       @default(false)
  shareLink     String?       @unique

  createdAt     DateTime      @default(now())

  files         StorageFile[]
  shares        StorageShare[]

  @@index([userId])
  @@index([parentId])
  @@index([isTrashed])
}

model StorageShare {
  id            String        @id @default(cuid())

  fileId        String?
  file          StorageFile?  @relation(fields: [fileId], references: [id], onDelete: Cascade)

  folderId      String?
  folder        StorageFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  email         String?

  isPublicLink  Boolean       @default(false)

  permission    String        // "view", "comment", "edit"

  expiresAt     DateTime?

  sharedAt      DateTime      @default(now())
  sharedBy      String

  @@index([fileId])
  @@index([folderId])
  @@index([userId])
  @@index([email])
}

model StorageFileVersion {
  id            String        @id @default(cuid())
  fileId        String
  file          StorageFile   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  versionNumber Int
  fileSize      BigInt
  storageUrl    String
  storageKey    String

  uploadedBy    String
  comment       String?       @db.Text

  createdAt     DateTime      @default(now())

  @@index([fileId])
}

model StorageQuota {
  id            String        @id @default(cuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalQuota    BigInt        @default(10737418240)  // 10GB
  usedSpace     BigInt        @default(0)

  lastCalculated DateTime     @default(now())

  @@index([userId])
}

// ============================================
// Phase 2AL: Social Media Platform (Facebook/Instagram/LinkedIn Killer)
// ============================================

model SocialProfile {
  id            String        @id @default(cuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio           String?       @db.Text
  location      String?
  website       String?

  headline      String?
  company       String?
  jobTitle      String?

  coverPhoto    String?

  followersCount Int          @default(0)
  followingCount Int          @default(0)
  postsCount    Int           @default(0)

  isPrivate     Boolean       @default(false)
  isVerified    Boolean       @default(false)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  posts         Post[]
  following     Follow[]      @relation("Following")
  followers     Follow[]      @relation("Followers")

  @@index([userId])
}

model Follow {
  id            String        @id @default(cuid())

  followerId    String
  follower      SocialProfile @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)

  followingId   String
  following     SocialProfile @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt     DateTime      @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Post {
  id            String        @id @default(cuid())
  userId        String
  user          SocialProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  content       String?       @db.Text

  mediaUrls     String[]
  mediaType     String?

  pollOptions   Json?
  pollEndsAt    DateTime?

  linkUrl       String?
  linkTitle     String?
  linkDescription String?     @db.Text
  linkImage     String?

  visibility    String        @default("public")

  postType      String        @default("post")

  sharedPostId  String?

  likesCount    Int           @default(0)
  commentsCount Int           @default(0)
  sharesCount   Int           @default(0)
  viewsCount    Int           @default(0)

  isDeleted     Boolean       @default(false)
  isPinned      Boolean       @default(false)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  comments      Comment[]
  likes         Like[]
  shares        Share[]

  @@index([userId])
  @@index([createdAt])
  @@index([visibility])
}

model Comment {
  id            String        @id @default(cuid())
  postId        String
  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  content       String        @db.Text

  parentId      String?
  parent        Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]     @relation("CommentReplies")

  likesCount    Int           @default(0)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  likes         CommentLike[]

  @@index([postId])
  @@index([userId])
  @@index([parentId])
}

model Like {
  id            String        @id @default(cuid())
  postId        String
  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  reactionType  String        @default("like")

  createdAt     DateTime      @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model CommentLike {
  id            String        @id @default(cuid())
  commentId     String
  comment       Comment       @relation(fields: [commentId], references: [id], onDelete: Cascade)

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime      @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model Share {
  id            String        @id @default(cuid())
  postId        String
  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  comment       String?       @db.Text

  createdAt     DateTime      @default(now())

  @@index([postId])
  @@index([userId])
}

model Story {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  mediaType     String
  mediaUrl      String?

  backgroundColor String?
  textContent   String?       @db.Text

  visibility    String        @default("followers")

  viewsCount    Int           @default(0)

  expiresAt     DateTime

  createdAt     DateTime      @default(now())

  views         StoryView[]

  @@index([userId])
  @@index([expiresAt])
}

model StoryView {
  id            String        @id @default(cuid())
  storyId       String
  story         Story         @relation(fields: [storyId], references: [id], onDelete: Cascade)

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  viewedAt      DateTime      @default(now())

  @@unique([storyId, userId])
  @@index([storyId])
  @@index([userId])
}

model SocialGroup {
  id            String        @id @default(cuid())

  name          String
  description   String?       @db.Text
  coverImage    String?

  createdBy     String
  creator       User          @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  groupType     String

  requireApproval Boolean     @default(false)

  membersCount  Int           @default(1)
  postsCount    Int           @default(0)

  createdAt     DateTime      @default(now())

  members       GroupMember[]
  posts         GroupPost[]

  @@index([createdBy])
  @@index([groupType])
}

model GroupMember {
  id            String        @id @default(cuid())
  groupId       String
  group         SocialGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  role          String        @default("member")

  joinedAt      DateTime      @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model GroupPost {
  id            String        @id @default(cuid())
  groupId       String
  group         SocialGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  content       String        @db.Text
  mediaUrls     String[]

  likesCount    Int           @default(0)
  commentsCount Int           @default(0)

