// ============================================================================
// Phase 2AE - Video Editor (Premiere Pro Killer)
// ============================================================================

model VideoProject {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Project info
  name          String

