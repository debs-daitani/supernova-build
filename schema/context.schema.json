{
  "collectionName": "SupernovaContext",
  "displayName": "Supernova Context",
  "permissions": {
    "read": "Admin",
    "write": "Admin",
    "delete": "Admin"
  },
  "fields": [
    {
      "name": "_id",
      "type": "text",
      "required": true,
      "description": "Auto-generated unique identifier"
    },
    {
      "name": "contextId",
      "type": "text",
      "required": true,
      "description": "Custom context identifier"
    },
    {
      "name": "conversationId",
      "type": "text",
      "required": true,
      "description": "Reference to Conversations.conversationId"
    },
    {
      "name": "userId",
      "type": "text",
      "required": true,
      "description": "Reference to Users.userId"
    },
    {
      "name": "messageIds",
      "type": "array",
      "required": true,
      "description": "Array of message IDs in context"
    },
    {
      "name": "summary",
      "type": "text",
      "required": false,
      "description": "Context summary"
    },
    {
      "name": "entities",
      "type": "array",
      "required": false,
      "description": "Extracted entities (people, places, etc.)"
    },
    {
      "name": "topics",
      "type": "array",
      "required": false,
      "description": "Conversation topics"
    },
    {
      "name": "sentiment",
      "type": "text",
      "required": false,
      "description": "Context sentiment"
    },
    {
      "name": "createdAt",
      "type": "date",
      "required": true,
      "description": "Context creation timestamp"
    },
    {
      "name": "expiresAt",
      "type": "date",
      "required": true,
      "description": "Expiration timestamp"
    },
    {
      "name": "tokenCount",
      "type": "number",
      "required": false,
      "description": "Total tokens in context"
    },
    {
      "name": "metadata",
      "type": "object",
      "required": false,
      "description": "Additional context metadata"
    }
  ],
  "indexes": [
    {
      "name": "contextId_unique",
      "fields": ["contextId"],
      "unique": true
    },
    {
      "name": "conversationId_index",
      "fields": ["conversationId"],
      "unique": false
    },
    {
      "name": "userId_index",
      "fields": ["userId"],
      "unique": false
    },
    {
      "name": "expiresAt_index",
      "fields": ["expiresAt"],
      "unique": false
    }
  ]
}
