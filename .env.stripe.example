# Stripe Payment Infrastructure - Environment Variables
# Copy these to your .env file and fill in with your actual values

# ===========================================
# STRIPE CONFIGURATION
# ===========================================

# Stripe Secret Key (Server-side only)
# Get from: https://dashboard.stripe.com/test/apikeys
# Test mode: sk_test_...
# Live mode: sk_live_...
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Publishable Key (Server-side reference)
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe Publishable Key (Client-side - MUST start with NEXT_PUBLIC_)
# Same as above, but accessible in browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe Webhook Secret
# Local development: Get from `stripe listen --forward-to localhost:3001/api/stripe/webhook`
# Production: Get from Stripe Dashboard > Developers > Webhooks
# Format: whsec_...
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================

# Application URL (used for redirect URLs)
# Development: http://localhost:3001
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/supernova

# ===========================================
# AUTHENTICATION
# ===========================================

# JWT Secret for authentication
# Generate with: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ===========================================
# OPTIONAL STRIPE CONFIGURATION
# ===========================================

# Default Price ID (optional)
# If you have a default subscription price
STRIPE_PRICE_ID=price_your_default_price_id

# Stripe Tax Rates (optional)
# Comma-separated list of tax rate IDs
# STRIPE_TAX_RATES=txr_xxxxx,txr_yyyyy

# ===========================================
# DEVELOPMENT TOOLS
# ===========================================

# Enable Stripe request logging (optional)
# Set to 'true' for detailed Stripe API logs
# STRIPE_DEBUG=false

# ===========================================
# PRODUCTION CHECKLIST
# ===========================================

# Before deploying to production:
#
# [ ] Replace all test keys (sk_test_, pk_test_) with live keys (sk_live_, pk_live_)
# [ ] Update NEXT_PUBLIC_APP_URL to production domain
# [ ] Configure production webhook endpoint in Stripe Dashboard
# [ ] Update STRIPE_WEBHOOK_SECRET with production webhook secret
# [ ] Change JWT_SECRET to a new, secure value
# [ ] Enable Stripe radar for fraud prevention
# [ ] Configure tax settings in Stripe Dashboard (if applicable)
# [ ] Set up monitoring and alerting
# [ ] Test full payment flow with real card
# [ ] Configure customer portal settings in Stripe Dashboard
# [ ] Enable invoice emails in Stripe Dashboard
# [ ] Review and update subscription lifecycle email templates

# ===========================================
# STRIPE DASHBOARD LINKS
# ===========================================

# Test Mode Dashboard: https://dashboard.stripe.com/test
# Live Mode Dashboard: https://dashboard.stripe.com
# API Keys: https://dashboard.stripe.com/test/apikeys
# Webhooks: https://dashboard.stripe.com/test/webhooks
# Products: https://dashboard.stripe.com/test/products
# Customers: https://dashboard.stripe.com/test/customers
# Subscriptions: https://dashboard.stripe.com/test/subscriptions
# Billing Portal: https://dashboard.stripe.com/test/settings/billing/portal

# ===========================================
# TESTING RESOURCES
# ===========================================

# Test Cards: https://stripe.com/docs/testing#cards
# Success Card: 4242 4242 4242 4242
# Decline Card: 4000 0000 0000 0002
# 3D Secure: 4000 0025 0000 3155

# Webhook Testing:
# stripe listen --forward-to localhost:3001/api/stripe/webhook
# stripe trigger customer.subscription.created

