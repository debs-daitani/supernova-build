# Database
DATABASE_URL="postgresql://user:password@localhost:5432/daitaniverse?schema=public"

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# SendGrid Email
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=hello@daitaniverse.com
FROM_NAME="The dAItaniverse"

# Cloudinary (Image Upload)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Stripe (Payments)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Pricing (in pence/cents)
UPGRADE_PRICE=2600
MONTHLY_PRICE=1900
ANNUAL_PRICE=19900

# URLs
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Marketplace
MARKETPLACE_COMMISSION_PERCENT=6

# ============================================
# Phase 2F Addendum - Social Media Automation
# ============================================

# Meta/Facebook (for Instagram + Facebook integration)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_VERIFY_TOKEN=your-custom-webhook-verify-token

# ============================================
# Phase 2Q + 2R - AI Generation
# ============================================

# Image Generation: DALL-E 3 (uses OPENAI_API_KEY above)
# Pricing: ~$0.04/image (standard), ~$0.08/image (HD)

# Video Generation: RunwayML Gen-3
RUNWAY_API_KEY=your-runway-api-key
# Pricing: ~$0.05-0.10/second of video

# Alternative Video Services (optional):
# PIKA_API_KEY=your-pika-api-key
# HEYGEN_API_KEY=your-heygen-api-key

# Usage Limits (monthly quotas)
FREE_TIER_IMAGES_PER_MONTH=10
FREE_TIER_VIDEOS_PER_MONTH=1
UPGRADE_TIER_IMAGES_PER_MONTH=50
UPGRADE_TIER_VIDEOS_PER_MONTH=5
MEMBER_TIER_IMAGES_PER_MONTH=200
MEMBER_TIER_VIDEOS_PER_MONTH=20
