  @@index([spaceId])
  @@index([userId])
}

model SpaceListener {
  id            String        @id @default(cuid())
  spaceId       String
  space         Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

