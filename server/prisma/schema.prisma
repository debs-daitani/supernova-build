// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  avatar        String?
  bio           String?  @db.Text
  location      String?
  niche         String?
  skills        String[] // Array of skills

  // Account type & status
  accountType   AccountType @default(FREE)
  isAdmin       Boolean  @default(false)
  emailVerified Boolean  @default(false)

  // Quiz results
  quizResult    QuizResult?
  quizAnswers   Json?    // Store quiz answers as JSON

  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastLogin     DateTime?

  // Relations
  conversations       Conversation[]
  messages            Message[]
  memories            Memory[]
  preferences         Preference[]
  payments            Payment[]
  subscriptions       Subscription[]
  listings            MarketplaceListing[]
  purchases           MarketplacePurchase[]
  sellerMessages      MarketplaceMessage[] @relation("SellerMessages")
  buyerMessages       MarketplaceMessage[] @relation("BuyerMessages")
  forumPosts          ForumPost[]
  forumComments       ForumComment[]
  forumLikes          ForumLike[]
  sentMessages        DirectMessage[] @relation("SentMessages")
  receivedMessages    DirectMessage[] @relation("ReceivedMessages")
  notifications       Notification[]
  contentProgress     ContentProgress[]

  // Phase 2D - User Empowerment Tools
  quizzes             Quiz[]
  linksPage           UserLinksPage?
  shortLinks          ShortLink[]
  brandHub            BrandHub?

  // Phase 2F - Chatbot Builder
  chatbots            Chatbot[]

  // Phase 2F Addendum - Social Media Automation
  socialAccounts      SocialAccount[]

  // Phase 2G - Website Builder
  websites            Website[]

  @@index([email])
  @@index([accountType])
  @@index([createdAt])
}

enum AccountType {
  FREE
  UPGRADE      // £26 one-time
  MEMBER       // Monthly/Annual subscription
}

enum QuizResult {
  GROUPIE
  ROADIE
  SUPPORT_ACT
  HEADLINER
}

// ============================================
// SUPERNOVA AI CHAT
// ============================================

model Conversation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String   @default("New Conversation")
  summary     String?  @db.Text
  isArchived  Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    Message[]

  @@index([userId])
  @@index([createdAt])
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  role            MessageRole
  content         String   @db.Text

  // Metadata
  tokenCount      Int?
  model           String?  // AI model used

  createdAt       DateTime @default(now())

  @@index([conversationId])
  @@index([userId])
  @@index([createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Memory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        MemoryType
  key         String   // e.g., "preferred_name", "business_goal", "main_challenge"
  value       String   @db.Text
  context     String?  @db.Text // Additional context

  importance  Int      @default(5) // 1-10 scale

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
  @@index([type])
}

enum MemoryType {
  PREFERENCE
  GOAL
  CHALLENGE
  ACHIEVEMENT
  FACT
  CONTEXT
}

model Preference {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  key         String   // e.g., "response_style", "preferred_pillar", "notification_email"
  value       String   @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

// ============================================
// PAYMENTS & SUBSCRIPTIONS
// ============================================

model Payment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripePaymentId String   @unique
  amount          Int      // In pence/cents
  currency        String   @default("gbp")
  status          PaymentStatus
  type            PaymentType

  description     String?

  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([status])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentType {
  UPGRADE
  SUBSCRIPTION_MONTHLY
  SUBSCRIPTION_ANNUAL
  MARKETPLACE_PURCHASE
}

model Subscription {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeSubscriptionId String @unique
  status            SubscriptionStatus
  plan              SubscriptionPlan

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  UNPAID
}

enum SubscriptionPlan {
  MONTHLY
  ANNUAL
}

// ============================================
// CONTENT LIBRARY
// ============================================

model Content {
  id          String   @id @default(cuid())

  title       String
  description String   @db.Text
  contentType ContentType
  pillar      Pillar
  tags        String[] // Array of tags

  accessLevel AccountType @default(FREE)

  // Content data
  url         String?  // For videos/external content
  fileUrl     String?  // For uploaded files (PDFs, audio)
  textContent String?  @db.Text // For text-based content

  // Organization
  orderIndex  Int      @default(0)

  // Analytics
  viewCount   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  progress    ContentProgress[]

  @@index([pillar])
  @@index([contentType])
  @@index([accessLevel])
  @@index([orderIndex])
}

enum ContentType {
  VIDEO
  TEXT
  AUDIO
  TEMPLATE
  PDF
  WORKSHEET
}

enum Pillar {
  BODY
  BRAIN
  BUSINESS
  GENERAL
}

model ContentProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId   String
  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  completed   Boolean  @default(false)
  progress    Int      @default(0) // 0-100 percentage

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
}

// ============================================
// MARKETPLACE
// ============================================

model MarketplaceListing {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String   @db.Text
  niche       String
  price       Int      // In pence

  // What's included
  includedItems String[] // Array of included items

  // Progress & needs
  progressLevel Int     @default(50) // 0-100
  needsHelp     String? @db.Text

  // Media
  images      String[] // Array of image URLs

  // Status
  status      ListingStatus @default(ACTIVE)

  // Analytics
  viewCount   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    MarketplaceMessage[]
  purchases   MarketplacePurchase[]

  @@index([userId])
  @@index([status])
  @@index([niche])
  @@index([createdAt])
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  ARCHIVED
}

model MarketplaceMessage {
  id          String   @id @default(cuid())
  listingId   String
  listing     MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  senderId    String
  sender      User     @relation("BuyerMessages", fields: [senderId], references: [id], onDelete: Cascade)

  sellerId    String
  seller      User     @relation("SellerMessages", fields: [sellerId], references: [id], onDelete: Cascade)

  content     String   @db.Text
  isRead      Boolean  @default(false)

  createdAt   DateTime @default(now())

  @@index([listingId])
  @@index([senderId])
  @@index([sellerId])
  @@index([isRead])
}

model MarketplacePurchase {
  id          String   @id @default(cuid())
  listingId   String
  listing     MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  buyerId     String
  buyer       User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  amount      Int      // In pence
  commission  Int      // Platform commission (6%)
  sellerAmount Int     // Amount seller receives

  stripePaymentId String @unique

  status      PurchaseStatus @default(PENDING)

  createdAt   DateTime @default(now())

  @@index([listingId])
  @@index([buyerId])
  @@index([status])
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  REFUNDED
}

// ============================================
// COMMUNITY / FORUM
// ============================================

model ForumCategory {
  id          String   @id @default(cuid())

  name        String   @unique
  description String   @db.Text
  icon        String?
  slug        String   @unique
  orderIndex  Int      @default(0)

  posts       ForumPost[]

  @@index([slug])
}

model ForumPost {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId  String
  category    ForumCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  title       String
  content     String   @db.Text

  isPinned    Boolean  @default(false)
  isLocked    Boolean  @default(false)

  viewCount   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comments    ForumComment[]
  likes       ForumLike[]

  @@index([userId])
  @@index([categoryId])
  @@index([createdAt])
  @@index([isPinned])
}

model ForumComment {
  id          String   @id @default(cuid())
  postId      String
  post        ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  content     String   @db.Text

  parentId    String?  // For nested replies
  parent      ForumComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     ForumComment[] @relation("CommentReplies")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([postId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
}

model ForumLike {
  id          String   @id @default(cuid())
  postId      String
  post        ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

// ============================================
// DIRECT MESSAGING
// ============================================

model DirectMessage {
  id          String   @id @default(cuid())

  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId  String
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  content     String   @db.Text
  isRead      Boolean  @default(false)

  createdAt   DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
  @@index([createdAt])
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        NotificationType
  title       String
  message     String   @db.Text
  link        String?  // URL to relevant page

  read        Boolean  @default(false)

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

enum NotificationType {
  MARKETPLACE_MESSAGE
  COMMUNITY_MENTION
  NEW_DM
  MARKETPLACE_SALE
  PAYMENT_SUCCESS
  SUBSCRIPTION_RENEWAL
  SYSTEM
}

// ============================================
// PHASE 2D - USER EMPOWERMENT TOOLS
// ============================================

// ============================================
// QUIZ BUILDER
// ============================================

model Quiz {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  description   String?       @db.Text
  slug          String        @unique  // For public URL: daitaniverse.space/quiz/[slug]

  published     Boolean       @default(false)

  // Styling
  coverImage    String?
  primaryColor  String        @default("#FF1493")  // Hot pink

  // Results
  resultTypes   Json          // Array of result types

  // Analytics
  viewCount     Int           @default(0)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  questions     QuizQuestion[]
  responses     QuizResponse[]

  @@index([userId])
  @@index([slug])
  @@index([published])
}

model QuizQuestion {
  id            String        @id @default(cuid())
  quizId        String
  quiz          Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)

  order         Int
  questionText  String        @db.Text
  questionType  String        // "multiple_choice", "scale", "text"

  // For multiple choice
  options       Json?         // Array of options with scores

  // For scale questions
  scaleMin      Int?
  scaleMax      Int?
  scaleMinLabel String?
  scaleMaxLabel String?

  required      Boolean       @default(true)

  @@index([quizId])
  @@index([order])
}

model QuizResponse {
  id                String    @id @default(cuid())
  quizId            String
  quiz              Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)

  respondentEmail   String?
  respondentName    String?

  answers           Json      // User's answers
  resultType        String    // Calculated result
  score             Int?

  createdAt         DateTime  @default(now())

  @@index([quizId])
  @@index([respondentEmail])
  @@index([createdAt])
}

// ============================================
// LINKS PAGE (AllMyLinks Alternative)
// ============================================

model UserLinksPage {
  id              String      @id @default(cuid())
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  username        String      @unique  // For URL: daitaniverse.space/@username

  // Page content
  displayName     String
  bio             String?     @db.Text
  avatar          String?

  // Styling
  theme           String      @default("default")  // "default", "minimal", "bold", "neon"
  backgroundColor String      @default("#FFFFFF")
  textColor       String      @default("#333333")
  accentColor     String      @default("#FF1493")

  // Analytics
  viewCount       Int         @default(0)

  published       Boolean     @default(false)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  links           UserLink[]

  @@index([username])
  @@index([published])
}

model UserLink {
  id            String        @id @default(cuid())
  linksPageId   String
  linksPage     UserLinksPage @relation(fields: [linksPageId], references: [id], onDelete: Cascade)

  title         String
  url           String
  icon          String?       // Icon name or emoji
  order         Int           @default(0)

  clickCount    Int           @default(0)
  active        Boolean       @default(true)

  createdAt     DateTime      @default(now())

  @@index([linksPageId])
  @@index([order])
}

// ============================================
// SHORT LINK GENERATOR
// ============================================

model ShortLink {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  shortCode     String           @unique  // e.g., "abc123"
  originalUrl   String           @db.Text

  title         String?          // Optional title for user's reference

  clickCount    Int              @default(0)
  active        Boolean          @default(true)

  expiresAt     DateTime?        // Optional expiration

  createdAt     DateTime         @default(now())

  clicks        ShortLinkClick[]

  @@index([userId])
  @@index([shortCode])
  @@index([active])
}

model ShortLinkClick {
  id            String    @id @default(cuid())
  shortLinkId   String
  shortLink     ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)

  // Analytics data
  ipAddress     String?
  userAgent     String?
  referer       String?
  country       String?

  clickedAt     DateTime  @default(now())

  @@index([shortLinkId])
  @@index([clickedAt])
}

// ============================================
// BRAND HUB (Personal Portfolio/Website)
// ============================================

model BrandHub {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  username      String    @unique  // For URL: daitaniverse.space/u/username

  // Hero section
  headline      String?
  tagline       String?   @db.Text
  coverImage    String?

  // About section
  about         String?   @db.Text

  // Services/offerings
  services      Json?     // Array of services

  // Portfolio/work samples
  portfolio     Json?     // Array of portfolio items

  // Testimonials
  testimonials  Json?     // Array of testimonials

  // Contact
  contactEmail  String?
  contactPhone  String?
  calendlyLink  String?

  // Styling
  theme         String    @default("professional")
  primaryColor  String    @default("#FF1493")

  // Analytics
  viewCount     Int       @default(0)

  published     Boolean   @default(false)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([username])
  @@index([published])
}

// ============================================
// PHASE 2F - CHATBOT BUILDER (ManyChat Alternative)
// ============================================

model Chatbot {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  description   String?       @db.Text

  // Where bot is deployed
  deploymentType String       @default("website")  // "website", "facebook", "instagram" (future)
  websiteUrl    String?

  // Styling
  primaryColor  String        @default("#FF1493")
  avatar        String?       // Bot avatar image
  welcomeMessage String?      @db.Text

  // Settings
  enabled       Boolean       @default(false)
  aiHandoffEnabled Boolean    @default(false)  // Can hand off to SUPERNova

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  flows         ChatbotFlow[]
  triggers      ChatbotTrigger[]
  conversations ChatbotConversation[]

  @@index([userId])
}

model ChatbotFlow {
  id            String        @id @default(cuid())
  chatbotId     String
  chatbot       Chatbot       @relation(fields: [chatbotId], references: [id], onDelete: Cascade)

  name          String
  description   String?

  // Visual flow builder data (node positions, connections)
  flowData      Json          // Stores entire flow structure

  active        Boolean       @default(true)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([chatbotId])
}

model ChatbotTrigger {
  id            String        @id @default(cuid())
  chatbotId     String
  chatbot       Chatbot       @relation(fields: [chatbotId], references: [id], onDelete: Cascade)

  flowId        String        // Which flow to trigger

  triggerType   String        // "keyword", "page_url", "time_delay", "user_action"

  // Trigger conditions
  keyword       String?       // If triggerType = "keyword"
  pageUrl       String?       // If triggerType = "page_url"
  delayMinutes  Int?          // If triggerType = "time_delay"

  active        Boolean       @default(true)

  createdAt     DateTime      @default(now())

  @@index([chatbotId])
  @@index([triggerType])
}

model ChatbotConversation {
  id            String        @id @default(cuid())
  chatbotId     String
  chatbot       Chatbot       @relation(fields: [chatbotId], references: [id], onDelete: Cascade)

  // Visitor info
  visitorId     String        // Anonymous ID (cookie-based)
  visitorEmail  String?       // If captured
  visitorName   String?       // If captured

  // Flow tracking
  currentFlowId String?
  currentNodeId String?

  // Captured variables
  variables     Json          @default("{}")  // All captured data (name, email, custom fields)

  // Status
  status        String        @default("active")  // "active", "completed", "abandoned", "handed_off_to_ai"

  startedAt     DateTime      @default(now())
  lastMessageAt DateTime      @default(now())
  completedAt   DateTime?

  // Relations
  messages      ChatbotMessage[]

  @@index([chatbotId])
  @@index([visitorId])
}

model ChatbotMessage {
  id                    String              @id @default(cuid())
  conversationId        String
  conversation          ChatbotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sender                String              // "bot" or "user"
  messageType           String              // "text", "button", "image", "delay"
  content               String?             @db.Text

  // For button responses
  buttonOptions         Json?
  selectedButton        String?

  createdAt             DateTime            @default(now())

  @@index([conversationId])
}

// ============================================
// PHASE 2F ADDENDUM - SOCIAL MEDIA AUTOMATION
// ============================================

model SocialAccount {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform      String        // "instagram", "facebook"
  accountId     String        // Instagram/Facebook user ID
  accountName   String        // @username or page name

  accessToken   String        @db.Text  // OAuth token
  refreshToken  String?       @db.Text
  tokenExpiry   DateTime?

  connected     Boolean       @default(true)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  automations   SocialAutomation[]

  @@unique([userId, platform, accountId])
  @@index([userId])
}

model SocialAutomation {
  id            String        @id @default(cuid())
  accountId     String
  account       SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name          String
  automationType String       // "comment_reply", "dm_sequence", "story_reply"

  // Triggers
  triggerType   String        // "keyword", "any_comment", "specific_post"
  keywords      String[]      // Keywords to trigger on
  postUrl       String?       // If specific_post

  // Actions
  actionFlow    Json          // Flow data (similar to chatbot flows)

  active        Boolean       @default(true)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  conversations SocialConversation[]

  @@index([accountId])
}

model SocialConversation {
  id            String        @id @default(cuid())
  automationId  String
  automation    SocialAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  platform      String        // "instagram", "facebook"
  threadId      String        // DM thread ID

  // User info
  socialUserId  String        // Their Instagram/Facebook ID
  socialUsername String?

  // Captured data
  leadName      String?
  leadEmail     String?
  customData    Json?         // Any other captured info

  // Flow tracking
  currentStepId String?
  variables     Json          @default("{}")

  status        String        @default("active")  // "active", "completed", "abandoned"

  startedAt     DateTime      @default(now())
  lastMessageAt DateTime      @default(now())
  completedAt   DateTime?

  messages      SocialMessage[]

  @@index([automationId])
  @@index([threadId])
}

model SocialMessage {
  id                String              @id @default(cuid())
  conversationId    String
  conversation      SocialConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  sender            String              // "bot" or "user"
  messageText       String?             @db.Text
  messageType       String              // "text", "button", "image", "quick_reply"

  buttonOptions     Json?

  createdAt         DateTime            @default(now())

  @@index([conversationId])
}

// ============================================
// PHASE 2G - WEBSITE BUILDER (The Wix Killer)
// ============================================

model Website {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Basic info
  name          String
  subdomain     String        @unique  // username.daitaniverse.space
  customDomain  String?       @unique  // user's own domain

  // Settings
  title         String?
  description   String?       @db.Text
  favicon       String?
  logo          String?

  // Theme
  template      String?       // Template ID they started with
  theme         Json          @default("{}")  // Colors, fonts, spacing

  // SEO
  seoTitle      String?
  seoDescription String?      @db.Text
  seoKeywords   String[]

  // Analytics
  googleAnalyticsId String?

  // Publishing
  published     Boolean       @default(false)
  publishedAt   DateTime?

  // Settings
  settings      Json          @default("{}")  // Various site settings

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  pages         WebsitePage[]

  @@index([userId])
  @@index([subdomain])
  @@index([customDomain])
}

model WebsitePage {
  id            String        @id @default(cuid())
  websiteId     String
  website       Website       @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  // Page info
  title         String
  slug          String        // URL slug (e.g., "about", "contact")

  // Page type
  pageType      String        @default("custom")  // "home", "about", "blog", "shop", "custom"

  // Content (JSON structure of blocks/components)
  content       Json          @default("{}")  // All page blocks/elements

  // SEO
  seoTitle      String?
  seoDescription String?      @db.Text

  // Settings
  published     Boolean       @default(true)
  order         Int           @default(0)  // Order in navigation

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([websiteId, slug])
  @@index([websiteId])
}

model WebsiteTemplate {
  id            String        @id @default(cuid())

  name          String
  description   String?       @db.Text
  category      String        // "business", "portfolio", "blog", "shop", "landing"

  // Preview
  thumbnail     String
  demoUrl       String?

  // Template structure
  pages         Json          // Pre-built pages
  theme         Json          // Default theme

  // Popularity
  usageCount    Int           @default(0)
  featured      Boolean       @default(false)

  createdAt     DateTime      @default(now())

  @@index([category])
}
