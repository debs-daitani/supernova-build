# Environment Configuration Template
# Copy this file to .env and update with your actual values

# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=development
APP_PORT=3000
APP_NAME=supernova-ai
APP_VERSION=1.0.0

# API Configuration
API_PREFIX=/api/v1
API_RATE_LIMIT=100
API_RATE_WINDOW=15

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=supernova
DB_PASSWORD=your_secure_password_here
DB_NAME=supernova_db
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false
DB_LOGGING=false

# ==========================================
# Redis Cache Configuration
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_TTL=3600

# Cache TTL (in seconds)
CACHE_SESSION_TTL=300
CACHE_USER_PREFS_TTL=300
CACHE_CONVERSATION_TTL=120

# ==========================================
# Security & Authentication
# ==========================================
JWT_SECRET=your_jwt_secret_min_32_chars_change_in_production
JWT_EXPIRY=24h
SESSION_SECRET=your_session_secret_min_32_chars_change_in_production
SESSION_EXPIRY=86400
API_KEY=your_api_key_for_external_access

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# ==========================================
# AI Service API Keys
# ==========================================
# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_MAX_TOKENS=2000

# ==========================================
# Logging Configuration
# ==========================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=7

# ==========================================
# Memory & Performance
# ==========================================
# Memory Retention (in days)
MEMORY_RETENTION_DAYS=90
CONTEXT_WINDOW_SIZE=50
MAX_MESSAGE_LENGTH=10000

# Session Configuration
SESSION_TIMEOUT_HOURS=24
SESSION_CLEANUP_INTERVAL=3600

# Performance Tuning
WORKER_THREADS=4
REQUEST_TIMEOUT=30000
MAX_CONCURRENT_REQUESTS=100

# ==========================================
# Monitoring & Observability
# ==========================================
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Health Check
HEALTH_CHECK_INTERVAL=30

# ==========================================
# Email Configuration (Optional)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@supernova-ai.com

# ==========================================
# Storage Configuration (Optional)
# ==========================================
# S3 or compatible object storage
S3_BUCKET=supernova-storage
S3_REGION=us-east-1
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_ENDPOINT=https://s3.amazonaws.com

# ==========================================
# Feature Flags
# ==========================================
ENABLE_SEMANTIC_SEARCH=false
ENABLE_CONVERSATION_SUMMARIES=true
ENABLE_KNOWLEDGE_EXTRACTION=true
ENABLE_ANALYTICS=true
ENABLE_DATA_EXPORT=true

# ==========================================
# Kubernetes Configuration (for K8s deployments)
# ==========================================
K8S_NAMESPACE=supernova
K8S_SERVICE_ACCOUNT=supernova-sa
K8S_CLUSTER_NAME=supernova-cluster

# ==========================================
# Development & Debug
# ==========================================
DEBUG=false
VERBOSE_LOGGING=false
ENABLE_SWAGGER=true
ENABLE_PLAYGROUND=true
