  replyTo       MicroPost?    @relation("PostReplies", fields: [replyToId], references: [id], onDelete: Cascade)
  replies       MicroPost[]   @relation("PostReplies")

  repostOfId    String?
  repostOf      MicroPost?    @relation("Reposts", fields: [repostOfId], references: [id], onDelete: SetNull)
  reposts       MicroPost[]   @relation("Reposts")

  isQuote       Boolean       @default(false)

  likesCount    Int           @default(0)
