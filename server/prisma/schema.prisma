// ============================================
// PHASE 2AT - DEMO VIDEO & SCREEN RECORDING SYSTEM
// ============================================

model DemoVideo {
  id            String        @id @default(cuid())

  // Video info
  title         String
  description   String?       @db.Text

  // Video file
  videoUrl      String
  thumbnailUrl  String
  duration      Int           // Seconds

  // Type
  videoType     String        // "demo", "tutorial", "testimonial", "feature_walkthrough"

  // Target
  category      String?       // "website_builder", "crm", "ecommerce", "overview", etc.

  // Interactive elements
  chapters      Json?         // [{time: 30, title: "Website Builder"}, ...]
  ctas          Json?         // [{time: 60, text: "Start Free Trial", url: "/signup"}]

  // Display settings
  featured      Boolean       @default(false)
  order         Int           @default(0)

  // Status
  isPublished   Boolean       @default(false)

  // Stats
  viewCount     Int           @default(0)
  avgWatchTime  Int?          // Average seconds watched
  completionRate Float?       // % who watched to end

  // SEO
  metaTitle     String?
  metaDescription String?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  publishedAt   DateTime?

  // Relations
  views         DemoVideoView[]

  @@index([videoType])
  @@index([featured])
  @@index([isPublished])
}

model DemoVideoView {
  id            String        @id @default(cuid())
  videoId       String
  video         DemoVideo     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Watch data
  watchTime     Int           // Seconds watched
  completed     Boolean       @default(false)

  // Drop-off point (if didn't complete)
  dropOffAt     Int?          // Second where they stopped

  // Source
  referrer      String?

  viewedAt      DateTime      @default(now())

  @@index([videoId])
  @@index([userId])
}

model VideoTestimonial {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Testimonial
  videoUrl      String
  thumbnailUrl  String?
  duration      Int?

  // Text version
  quote         String?       @db.Text

  // Status
  status        String        @default("pending")  // "pending", "approved", "rejected"

  // Display
  featured      Boolean       @default(false)
  displayOnHome Boolean       @default(false)

  submittedAt   DateTime      @default(now())
  reviewedAt    DateTime?

  @@index([userId])
  @@index([status])
  @@index([featured])
}

model ScreenRecording {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String?

  // Recording
  videoUrl      String
  thumbnailUrl  String?
  duration      Int

  // Type
  recordingType String        // "full_screen", "window", "tab"

  // Settings used
  includeAudio  Boolean
  includeCursor Boolean

  createdAt     DateTime      @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ============================================
// PHASE 2AU - LAUNCH ASSETS & COMPARISONS
// ============================================

model CompetitorTool {
  id            String        @id @default(cuid())

  // Tool info
  name          String
  category      String        // "website_builder", "crm", "ecommerce", etc.
  logo          String?
  website       String?

  // Pricing
  priceMonthly  Float
  priceYearly   Float?

  // Features (what they offer)
  features      Json          // Array of feature names

  // Limitations
  limitations   String[]      // What they DON'T have

  // Our equivalent
  ourEquivalent String        // Which dAItaniverse feature replaces this

  // Display
  isActive      Boolean       @default(true)
  order         Int           @default(0)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([category])
  @@index([isActive])
}

model FeatureComparison {
  id            String        @id @default(cuid())

  // Feature name
  feature       String
  category      String?

  // Who has it
  daitaniverse  Boolean       @default(true)
  competitor1   String?       // Competitor name
  competitor1Has Boolean?
  competitor2   String?
  competitor2Has Boolean?
  competitor3   String?
  competitor3Has Boolean?
  competitor4   String?
  competitor4Has Boolean?

  // Details
  ourImplementation String?    @db.Text
  notes         String?       @db.Text

  // Display
  order         Int           @default(0)
  highlighted   Boolean       @default(false)
  isActive      Boolean       @default(true)

  createdAt     DateTime      @default(now())

  @@index([category])
  @@index([order])
  @@index([isActive])
}

model ROICalculation {
  id            String        @id @default(cuid())
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  // User's current stack
  currentTools  Json          // [{tool: "Wix", monthly: 30}, {tool: "Shopify", monthly: 29}]

  // Calculated savings
  currentCost   Float
  daitaniverseCost Float      @default(26)
  monthlySavings Float
  yearlySavings Float

  // Email (for lead capture)
  email         String?
  name          String?

  // Stats
  shared        Boolean       @default(false)
  converted     Boolean       @default(false)

  // Source
  referrer      String?

  calculatedAt  DateTime      @default(now())

  @@index([userId])
  @@index([email])
  @@index([calculatedAt])
}

// ============================================
// PHASE 2AV - TESTIMONIAL SYSTEM
// ============================================

model Testimonial {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Testimonial content
  content       String        @db.Text

  // Rating
  rating        Int?          // 1-5 stars (optional)

  // Media
  photoUrl      String?
  videoUrl      String?
  videoThumbnail String?

  // Author info (can override user info)
  authorName    String
  authorRole    String?       // "Entrepreneur", "Coach", "Agency Owner"
  authorCompany String?
  authorPhoto   String?

  // Context
  useCase       String?       // What they use platform for
  category      String?       // "website_builder", "crm", "overall", etc.

  // Status
  status        String        @default("pending")  // "pending", "approved", "rejected", "featured"

  // Display settings
  featured      Boolean       @default(false)
  displayOnHome Boolean       @default(false)
  order         Int           @default(0)

  // Source
  source        String?       // "quiz_tester", "customer", "campaign"

  // Metadata
  submittedAt   DateTime      @default(now())
  reviewedAt    DateTime?
  reviewedBy    String?

  // Relations
  requests      TestimonialRequest[]

  @@index([userId])
  @@index([status])
  @@index([featured])
  @@index([category])
  @@index([rating])
}

model TestimonialRequest {
  id            String        @id @default(cuid())

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Request details
  requestType   String        // "email", "in_app", "sms"

  // Status
  status        String        @default("sent")  // "sent", "opened", "submitted", "declined"

  // Tracking
  sentAt        DateTime      @default(now())
  openedAt      DateTime?
  submittedAt   DateTime?

  // Link to submitted testimonial
  testimonialId String?
  testimonial   Testimonial?  @relation(fields: [testimonialId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model TestimonialWidget {
  id            String        @id @default(cuid())

  // Widget settings
  name          String
  widgetType    String        // "carousel", "grid", "single", "wall"

  // Filters
  category      String?       // Show only specific category
  featuredOnly  Boolean       @default(false)
  minRating     Int?          // Show only X stars and above

  // Display settings
  showPhoto     Boolean       @default(true)
  showRating    Boolean       @default(true)
  showRole      Boolean       @default(true)
  maxItems      Int           @default(3)

  // Style
  theme         String        @default("light")  // "light", "dark", "custom"
  customCSS     String?       @db.Text

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([widgetType])
}

// ============================================
// PHASE 2AW: REFERRAL PROGRAM
// ============================================

model Referral {
  id            String        @id @default(cuid())

  // Referrer (person who shared)
  referrerId    String
  referrer      User          @relation("Referrals", fields: [referrerId], references: [id], onDelete: Cascade)

  // Referred user (new signup)
  referredId    String
  referred      User          @relation("ReferredBy", fields: [referredId], references: [id], onDelete: Cascade)

  // Tracking
  referralCode  String        // Unique code used

  // Status
  status        String        @default("pending")  // "pending", "qualified", "rewarded"

  // Qualification (e.g., referred user must subscribe)
  qualified     Boolean       @default(false)
  qualifiedAt   DateTime?

  // Reward
  rewardType    String?       // "free_month", "credit", "cash"
  rewardAmount  Float?
  rewardGiven   Boolean       @default(false)
  rewardGivenAt DateTime?

  // Source
  source        String?       // "email", "social", "link", "whatsapp"

  createdAt     DateTime      @default(now())

  // Relations
  rewards       ReferralReward[]

  @@unique([referrerId, referredId])
  @@index([referrerId])
  @@index([referredId])
  @@index([referralCode])
  @@index([status])
}

model ReferralCode {
  id            String        @id @default(cuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Code
  code          String        @unique  // e.g., "DEBS2026" or random

  // Stats
  clicks        Int           @default(0)
  signups       Int           @default(0)
  conversions   Int           @default(0)

  // Rewards earned
  totalRewards  Float         @default(0)

  createdAt     DateTime      @default(now())

  @@index([code])
}

model ReferralReward {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Reward details
  rewardType    String        // "free_month", "credit", "cash", "upgrade"
  amount        Float?
  description   String

  // Status
  status        String        @default("pending")  // "pending", "issued", "redeemed"

  // Related referral
  referralId    String?
  referral      Referral?     @relation(fields: [referralId], references: [id], onDelete: SetNull)

  // Milestone (if milestone reward)
  milestone     String?       // "5_referrals", "10_referrals", "25_referrals", "50_referrals"

  // Dates
  earnedAt      DateTime      @default(now())
  issuedAt      DateTime?
  redeemedAt    DateTime?
  expiresAt     DateTime?

  @@index([userId])
  @@index([status])
  @@index([referralId])
}

model ReferralCampaign {
  id            String        @id @default(cuid())

  // Campaign info
  name          String
  description   String?       @db.Text

  // Reward structure
  referrerReward String       // "1_month_free"
  referredReward String       // "1_month_free"

  // Qualification rules
  requiresPayment Boolean     @default(true)
  minSubscriptionDays Int?    // Must stay subscribed X days

  // Milestones
  milestones    Json?         // [{count: 5, reward: "bonus_month"}, ...]

  // Status
  isActive      Boolean       @default(true)

  // Dates
  startDate     DateTime?
  endDate       DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([isActive])
}

// ============================================
// PHASE 2AX - ONBOARDING SYSTEM
// ============================================

model OnboardingProgress {
  id            String        @id @default(cuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Progress tracking
  currentStep   String?       // Current step ID
  completedSteps Json         @default("[]")  // Array of completed step IDs
  progressPercent Int         @default(0)

  // User selections
  primaryGoal   String?       // "website", "courses", "ecommerce", "crm", "all"
  selectedFeatures Json?      // Array of features user wants to use

  // Milestones
  hasCompletedWelcome     Boolean   @default(false)
  hasCompletedTour        Boolean   @default(false)
  hasSeenQuickWins        Boolean   @default(false)
  firstWebsiteCreated     Boolean   @default(false)
  firstCourseCreated      Boolean   @default(false)
  firstProductAdded       Boolean   @default(false)
  firstContactAdded       Boolean   @default(false)
  firstSaleMade           Boolean   @default(false)

  // Settings
  showTips      Boolean       @default(true)
  skipOnboarding Boolean      @default(false)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([primaryGoal])
}

model OnboardingStep {
  id            String        @id @default(cuid())

  // Step info
  stepId        String        @unique  // e.g., "welcome", "goal-selection"
  title         String
  description   String        @db.Text
  icon          String?

  // Content
  videoUrl      String?
  imageUrl      String?
  ctaText       String?
  ctaUrl        String?

  // Requirements
  prerequisiteSteps Json?     // Array of step IDs that must be completed first
  requiredForGoals  Json?     // Array of goals this step is required for

  // Action to complete
  completionAction  String?   // "click_button", "create_website", "add_product", etc.

  // Display
  order         Int           @default(0)
  category      String?       // "setup", "first_steps", "advanced"
  isActive      Boolean       @default(true)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([stepId])
  @@index([category])
  @@index([order])
}

model QuickWin {
  id            String        @id @default(cuid())

  // Quick win info
  title         String
  description   String        @db.Text
  icon          String?

  // Goal association
  relatedGoal   String?       // "website", "courses", "ecommerce", "crm", "all"

  // Action
  actionUrl     String?       // Where to go to complete
  actionType    String?       // "create", "customize", "publish", "share"
  actionText    String?       // Button text

  // Rewards
  rewardPoints  Int           @default(0)
  rewardBadge   String?

  // Metadata
  estimatedTime String?       // "2 min", "5 min", etc.
  difficulty    String?       // "easy", "medium", "hard"
  order         Int           @default(0)

  // Relations
  userQuickWins UserQuickWin[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([relatedGoal])
  @@index([order])
}

model UserQuickWin {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  quickWinId    String
  quickWin      QuickWin      @relation(fields: [quickWinId], references: [id], onDelete: Cascade)

  // Completion
  completed     Boolean       @default(false)
  completedAt   DateTime?

  // Points earned
  pointsEarned  Int           @default(0)

  createdAt     DateTime      @default(now())

  @@unique([userId, quickWinId])
  @@index([userId])
  @@index([quickWinId])
  @@index([completed])
}

model TutorialProgress {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Tutorial info
  tutorialId    String        // e.g., "website-basics", "ecommerce-setup"
  tutorialTitle String
  category      String?

  // Progress
  currentStep   Int           @default(0)
  totalSteps    Int
  watchTime     Int           @default(0)  // Seconds watched

  // Status
  completed     Boolean       @default(false)
  completedAt   DateTime?

  // Bookmarks
  bookmarked    Boolean       @default(false)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([userId, tutorialId])
  @@index([userId])
  @@index([tutorialId])
  @@index([completed])
}

// ============================================
// PHASE 2AY - SUPERNova AI BRAIN SYSTEM
// ============================================

model KnowledgeBase {
  id            String        @id @default(cuid())

  // Version control
  version       String        @unique  // "v1.0", "v1.1", etc.

  // Content (your brain!)
  content       String        @db.Text  // Full brain document

  // Structured data
  frameworks    Json?         // Your frameworks extracted
  pillars       Json?         // 3 pillars: Body, Brain, Business
  methodologies Json?         // Your coaching methodologies
  voiceTone     Json?         // Voice guidelines
  firstContactProtocol Json?  // How to greet new users

  // Metadata
  isActive      Boolean       @default(false)
  description   String?       @db.Text

  // Stats
  tokenCount    Int?          // For AI context limits

  // Dates
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  activatedAt   DateTime?

  @@index([isActive])
  @@index([version])
}

model AIConversation {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Conversation context
  conversationType String      // "chat", "content_gen", "coaching", "support", "first_contact"

  // Current topic
  topic         String?
  category      String?       // "business", "marketing", "mindset", etc.

  // Messages
  messages      Json          @default("[]")  // Array of {role, content, timestamp}

  // Knowledge used
  knowledgeVersion String?

  // User preferences collected
  preferencesCollected Boolean @default(false)

  // Status
  isActive      Boolean       @default(true)

  // Dates
  startedAt     DateTime      @default(now())
  lastMessageAt DateTime      @default(now())

  @@index([userId])
  @@index([conversationType])
  @@index([isActive])
}

model CoachingMoment {
  id            String        @id @default(cuid())

  // Trigger
  triggerEvent  String        // "first_website", "stuck_on_task", "milestone_reached"

  // Coaching content
  title         String
  message       String        @db.Text

  // Related framework
  framework     String?       // Which of your frameworks to reference
  pillar        String?       // "body", "brain", "business"

  // CTA
  actionText    String?
  actionUrl     String?

  // Display settings
  showOnce      Boolean       @default(false)
  priority      Int           @default(0)

  // Relations
  userLogs      UserCoachingLog[]

  createdAt     DateTime      @default(now())

  @@index([triggerEvent])
}

model UserCoachingLog {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  momentId      String
  moment        CoachingMoment @relation(fields: [momentId], references: [id], onDelete: Cascade)

  // When shown
  shownAt       DateTime      @default(now())

  // User action
  dismissed     Boolean       @default(false)
  actionTaken   Boolean       @default(false)

  @@index([userId])
  @@index([momentId])
}

model AIInsight {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Insight
  insightType   String        // "stuck_pattern", "progress", "opportunity"
  title         String
  description   String        @db.Text

  // Recommendation
  recommendation String       @db.Text

  // Status
  viewed        Boolean       @default(false)
  actedOn       Boolean       @default(false)

  generatedAt   DateTime      @default(now())

  @@index([userId])
  @@index([insightType])
}

// ============================================
// PHASE 2AZ - EMAIL AUTOMATION SEQUENCES
// ============================================

model EmailSequence {
  id            String        @id @default(cuid())

  // Sequence info
  name          String
  description   String?       @db.Text

  // Type
  sequenceType  String        // "welcome", "onboarding", "upgrade", "engagement", "launch", etc.

  // Trigger
  triggerEvent  String        // "user_signup", "trial_start", "inactive_7days", etc.
  triggerDelay  Int?          // Minutes to wait before starting (0 = immediate)

  // Conditions
  conditions    Json?         // {userType: "free", hasCompletedOnboarding: false}

  // Status
  isActive      Boolean       @default(true)

  // Stats
  recipientsCount Int         @default(0)
  openRate      Float?
  clickRate     Float?
  conversionRate Float?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  emails        SequenceEmail[]
  enrollments   SequenceEnrollment[]

  @@index([sequenceType])
  @@index([isActive])
}

model SequenceEmail {
  id            String        @id @default(cuid())
  sequenceId    String
  sequence      EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  // Email order
  order         Int

  // Timing
  delayDays     Int           // Days after previous email (0 for first email)
  delayHours    Int           @default(0)  // Additional hours

  // Content
  subject       String
  previewText   String?
  htmlContent   String        @db.Text
  textContent   String        @db.Text

  // Personalization
  variables     String[]      // Available merge tags: {{name}}, {{preferredName}}, etc.

  // CTA
  ctaText       String?
  ctaUrl        String?

  // A/B Testing
  variantOf     String?       // If A/B test, link to original

  // Stats
  sentCount     Int           @default(0)
  openCount     Int           @default(0)
  clickCount    Int           @default(0)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([sequenceId])
  @@index([order])
}

model SequenceEnrollment {
  id            String        @id @default(cuid())

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  sequenceId    String
  sequence      EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  // Progress
  currentStep   Int           @default(0)  // Which email they're on

  // Status
  status        String        @default("active")  // "active", "completed", "paused", "unsubscribed"

  // Tracking
  enrolledAt    DateTime      @default(now())
  completedAt   DateTime?
  pausedAt      DateTime?

  // Next email
  nextEmailAt   DateTime?

  @@unique([userId, sequenceId])
  @@index([userId])
  @@index([sequenceId])
  @@index([status])
  @@index([nextEmailAt])
}

model EmailDelivery {
  id            String        @id @default(cuid())

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  sequenceId    String?
  emailId       String?       // Which email in sequence

  // Content sent
  subject       String
  content       String        @db.Text

  // Delivery
  status        String        @default("pending")  // "pending", "sent", "delivered", "bounced", "failed"

  // Engagement
  opened        Boolean       @default(false)
  openedAt      DateTime?
  clicked       Boolean       @default(false)
  clickedAt     DateTime?
  clickedUrl    String?

  // Metadata
  provider      String?       // "sendgrid", "mailgun", "aws_ses"
  providerId    String?       // External tracking ID

  sentAt        DateTime?
  deliveredAt   DateTime?

  @@index([userId])
  @@index([sequenceId])
  @@index([status])
  @@index([sentAt])
}

// ============================================
// PHASE 2BA: LANDING PAGE SYSTEM
// ============================================

model LandingPage {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Page info
  title         String
  slug          String        @unique

  // Template
  templateType  String        // "sales", "webinar", "product", "waitlist", "launch"

  // Content (JSON structure)
  sections      Json          // Array of section configs

  // SEO
  metaTitle     String?
  metaDescription String?     @db.Text
  ogImage       String?

  // Conversion elements
  primaryCTA    String        // "Start Free Trial", "Join Waitlist", etc.
  ctaUrl        String        // Where CTA button goes

  // Settings
  customCSS     String?       @db.Text
  customJS      String?       @db.Text
  headerCode    String?       @db.Text  // Analytics, pixels
  footerCode    String?       @db.Text

  // Exit intent
  exitIntentEnabled Boolean   @default(false)
  exitIntentContent Json?

  // A/B Testing
  isVariant     Boolean       @default(false)
  variantOf     String?       // Original page ID
  trafficSplit  Int           @default(50)  // % of traffic to this variant

  // Status
  isPublished   Boolean       @default(false)
  publishedAt   DateTime?

  // Stats
  views         Int           @default(0)
  uniqueViews   Int           @default(0)
  conversions   Int           @default(0)
  conversionRate Float?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  pageViews     LandingPageView[]
  conversions   LandingPageConversion[]

  @@index([userId])
  @@index([slug])
  @@index([isPublished])
}

model LandingPageView {
  id            String        @id @default(cuid())

  pageId        String
  page          LandingPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  // Visitor tracking
  visitorId     String        // Anonymous ID (cookie)
  userId        String?       // If logged in

  // Source
  referrer      String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?

  // Device
  device        String?       // "desktop", "mobile", "tablet"
  browser       String?
  os            String?

  // Location
  country       String?
  city          String?

  // Behavior
  timeOnPage    Int?          // Seconds
  scrollDepth   Int?          // Percentage

  viewedAt      DateTime      @default(now())

  @@index([pageId])
  @@index([visitorId])
  @@index([viewedAt])
}

model LandingPageConversion {
  id            String        @id @default(cuid())

  pageId        String
  page          LandingPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  // Who converted
  visitorId     String
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  // What action
  conversionType String       // "signup", "purchase", "waitlist", "download"

  // Value
  value         Float?        // Revenue if applicable

  // Attribution
  referrer      String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?

  convertedAt   DateTime      @default(now())

  @@index([pageId])
  @@index([userId])
  @@index([convertedAt])
}

model LandingPageTemplate {
  id            String        @id @default(cuid())

  // Template info
  name          String
  description   String?       @db.Text
  category      String        // "sales", "product", "webinar", "waitlist"

  // Preview
  thumbnail     String?
  demoUrl       String?

  // Structure
  sections      Json          // Default section configs

  // Conversion rate (from all pages using this)
  avgConversionRate Float?

  // Status
  isActive      Boolean       @default(true)
  isPremium     Boolean       @default(false)

  createdAt     DateTime      @default(now())

  @@index([category])
  @@index([isActive])
}

// ============================================
// PHASE 2BB: SIGNUP FLOW BUILDER
// ============================================

model SignupFlow {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Flow info
  name          String
  slug          String        @unique

  // Type
  flowType      String        // "lead_magnet", "waitlist", "trial", "newsletter", "event", "quiz"

  // Steps (JSON array of step configs)
  steps         Json          // [{stepId, title, fields: [...]}]

  // Settings
  showProgress  Boolean       @default(true)
  allowBack     Boolean       @default(true)  // Can go back to previous step

  // Confirmation
  confirmationType String     @default("page")  // "page", "redirect", "inline"
  confirmationMessage String? @db.Text
  confirmationUrl String?

  // Lead magnet (if applicable)
  leadMagnetUrl String?
  leadMagnetName String?

  // Email integration
  sendToEmail   String?       // Admin notification email
  emailListId   String?       // Which email list to add to
  autoResponder String?       // Auto-reply email template

  // Design
  theme         String        @default("default")
  customCSS     String?       @db.Text

  // SEO
  metaTitle     String?
  metaDescription String?

  // Status
  isPublished   Boolean       @default(false)
  publishedAt   DateTime?

  // Stats
  views         Int           @default(0)
  starts        Int           @default(0)  // Started filling form
  completions   Int           @default(0)
  conversionRate Float?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  submissions   SignupSubmission[]

  @@index([userId])
  @@index([slug])
  @@index([flowType])
}

model SignupSubmission {
  id            String        @id @default(cuid())

  flowId        String
  flow          SignupFlow    @relation(fields: [flowId], references: [id], onDelete: Cascade)

  // Submitter
  visitorId     String        // Anonymous tracking
  userId        String?       // If logged in
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Form data
  data          Json          // All field values

  // Progress
  currentStep   Int           @default(0)
  totalSteps    Int
  completed     Boolean       @default(false)

  // Source
  referrer      String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?

  // Timing
  timeToComplete Int?         // Seconds

  startedAt     DateTime      @default(now())
  completedAt   DateTime?

  @@index([flowId])
  @@index([completed])
  @@index([completedAt])
}

model SignupFlowTemplate {
  id            String        @id @default(cuid())

  // Template info
  name          String
  description   String?       @db.Text
  category      String        // "lead_magnet", "waitlist", "trial", etc.

  // Preview
  thumbnail     String?

  // Structure
  steps         Json          // Default steps config

  // Stats
  avgConversionRate Float?

  // Status
  isActive      Boolean       @default(true)

  createdAt     DateTime      @default(now())

  @@index([category])
}

// ============================================
// PHASE 2BC: CHECKOUT SYSTEM
// ============================================

model CheckoutPage {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Page info
  name          String
  slug          String        @unique

  // What's being sold
  productType   String        // "product", "course", "service", "membership", "digital"
  productIds    String[]      // Array of product IDs being sold

  // Pricing
  basePrice     Float
  currency      String        @default("GBP")

  // Payment options
  allowOneTime  Boolean       @default(true)
  allowSubscription Boolean   @default(false)
  subscriptionInterval String? // "monthly", "yearly"

  allowPaymentPlan Boolean    @default(false)
  paymentPlanConfig Json?     // {installments: 3, interval: "monthly"}

  // Upsells
  hasUpsell     Boolean       @default(false)
  upsellOffer   Json?         // {productId, price, headline, description}

  // Order bumps
  orderBumps    Json[]        // [{productId, price, label, checked: false}]

  // Coupons
  allowCoupons  Boolean       @default(true)

  // Content sections (JSON)
  sections      Json          // Array of section configs

  // Trust elements
  showGuarantee Boolean       @default(true)
  guaranteeText String?       @db.Text
  showSecurity  Boolean       @default(true)
  showTestimonials Boolean    @default(false)
  testimonials  Json[]

  // Design
  theme         String        @default("default")
  customCSS     String?       @db.Text

  // SEO
  metaTitle     String?
  metaDescription String?

  // Status
  isPublished   Boolean       @default(false)
  publishedAt   DateTime?

  // Stats
  views         Int           @default(0)
  checkouts     Int           @default(0)
  completedOrders Int         @default(0)
  revenue       Float         @default(0)
  conversionRate Float?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  orders        Order[]
  abandonedCheckouts AbandonedCheckout[]
  thankYouPages ThankYouPage[]

  @@index([userId])
  @@index([slug])
}

model Order {
  id            String        @id @default(cuid())

  // Buyer
  customerId    String?
  customer      User?         @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: SetNull)

  // Seller
  sellerId      String
  seller        User          @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Cascade)

  // Checkout page used
  checkoutPageId String?
  checkoutPage  CheckoutPage? @relation(fields: [checkoutPageId], references: [id], onDelete: SetNull)

  // Order details
  orderNumber   String        @unique

  // Items
  items         Json          // [{productId, name, price, quantity}]

  // Pricing
  subtotal      Float
  discount      Float         @default(0)
  tax           Float         @default(0)
  total         Float
  currency      String        @default("GBP")

  // Coupon used
  couponCode    String?

  // Payment
  paymentMethod String        // "stripe", "paypal", "card"
  paymentStatus String        @default("pending")  // "pending", "paid", "failed", "refunded"

  // Payment provider IDs
  stripePaymentIntentId String?
  stripeChargeId String?
  paypalOrderId String?

  // Payment plan
  isPaymentPlan Boolean       @default(false)
  paymentPlanConfig Json?

  // Subscription
  isSubscription Boolean      @default(false)
  subscriptionId String?

  // Customer info
  customerEmail String
  customerName  String
  billingAddress Json?

  // Fulfillment
  fulfillmentStatus String    @default("pending")  // "pending", "processing", "completed"
  trackingNumber String?

  // Timestamps
  createdAt     DateTime      @default(now())
  paidAt        DateTime?
  fulfilledAt   DateTime?

  // Relations
  thankYouPageViews ThankYouPageView[]
  postPurchaseSurveys PostPurchaseSurvey[]

  @@index([customerId])
  @@index([sellerId])
  @@index([orderNumber])
  @@index([paymentStatus])
  @@index([createdAt])
}

model Coupon {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Coupon info
  code          String        @unique
  description   String?

  // Discount
  discountType  String        // "percentage", "fixed_amount"
  discountValue Float         // 20 (for 20% off) or 10 (for £10 off)

  // Restrictions
  minPurchase   Float?
  maxDiscount   Float?        // Cap for percentage discounts

  // Products
  applicableProducts String[]  // Empty = all products

  // Usage limits
  usageLimit    Int?          // Total times can be used
  usageCount    Int           @default(0)
  perUserLimit  Int?          // Times per customer

  // Validity
  startDate     DateTime?
  expiryDate    DateTime?

  // Status
  isActive      Boolean       @default(true)

  createdAt     DateTime      @default(now())

  @@index([code])
  @@index([userId])
}

model AbandonedCheckout {
  id            String        @id @default(cuid())

  checkoutPageId String
  checkoutPage  CheckoutPage  @relation(fields: [checkoutPageId], references: [id], onDelete: Cascade)

  // Visitor
  visitorId     String
  customerEmail String?

  // Cart data
  items         Json
  subtotal      Float

  // Recovery
  recoveryEmailSent Boolean   @default(false)
  recoveryEmailSentAt DateTime?
  recovered     Boolean       @default(false)
  recoveredAt   DateTime?

  abandonedAt   DateTime      @default(now())

  @@index([checkoutPageId])
  @@index([recoveryEmailSent])
}

// ============================================
// PHASE 2BD: THANK YOU PAGE SYSTEM
// ============================================

model ThankYouPage {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Page info
  name          String
  slug          String        @unique

  // Linked to checkout
  checkoutPageId String?
  checkoutPage  CheckoutPage? @relation(fields: [checkoutPageId], references: [id], onDelete: SetNull)

  // Content sections
  sections      Json          // Array of section configs

  // Upsells (post-purchase)
  hasUpsell     Boolean       @default(false)
  upsellOffer   Json?

  hasDownsell   Boolean       @default(false)
  downsellOffer Json?

  // Social sharing
  enableSharing Boolean       @default(true)
  shareMessage  String?       @db.Text
  shareIncentive String?      // "Share and get 10% off your next order"

  // Community
  showCommunityJoin Boolean   @default(false)
  communityName String?
  communityUrl  String?

  // Next steps
  showNextSteps Boolean       @default(true)
  nextSteps     Json[]        // [{icon, title, description, actionUrl}]

  // Calendar booking
  enableCalendar Boolean      @default(false)
  calendlyUrl   String?

  // Survey
  enableSurvey  Boolean       @default(false)
  surveyQuestions Json[]

  // Tracking
  facebookPixelId String?
  googleAnalyticsId String?
  customTrackingCode String?  @db.Text

  // Design
  theme         String        @default("celebration")
  customCSS     String?       @db.Text

  // Status
  isPublished   Boolean       @default(false)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  views         ThankYouPageView[]

  @@index([userId])
  @@index([slug])
}

model ThankYouPageView {
  id            String        @id @default(cuid())

  pageId        String
  page          ThankYouPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  orderId       String?
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Actions taken
  upsellAccepted Boolean      @default(false)
  downsellAccepted Boolean    @default(false)
  shared        Boolean       @default(false)
  surveyCompleted Boolean     @default(false)
  calendarBooked Boolean      @default(false)

  viewedAt      DateTime      @default(now())

  @@index([pageId])
  @@index([orderId])
}

model PostPurchaseSurvey {
  id            String        @id @default(cuid())

  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Responses
  responses     Json          // {question: answer}

  // Testimonial consent
  canUseAsTestimonial Boolean @default(false)

  submittedAt   DateTime      @default(now())

  @@index([orderId])
}
