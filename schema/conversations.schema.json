{
  "collectionName": "SupernovaConversations",
  "displayName": "Supernova Conversations",
  "permissions": {
    "read": "Anyone",
    "write": "Admin",
    "delete": "Admin"
  },
  "fields": [
    {
      "name": "_id",
      "type": "text",
      "required": true,
      "description": "Auto-generated unique identifier"
    },
    {
      "name": "conversationId",
      "type": "text",
      "required": true,
      "description": "Custom conversation identifier"
    },
    {
      "name": "userId",
      "type": "text",
      "required": true,
      "description": "Reference to Users.userId"
    },
    {
      "name": "title",
      "type": "text",
      "required": false,
      "description": "Conversation title (auto or manual)"
    },
    {
      "name": "summary",
      "type": "text",
      "required": false,
      "description": "AI-generated conversation summary"
    },
    {
      "name": "startedAt",
      "type": "date",
      "required": true,
      "description": "Conversation start timestamp"
    },
    {
      "name": "lastMessageAt",
      "type": "date",
      "required": true,
      "description": "Last message timestamp"
    },
    {
      "name": "endedAt",
      "type": "date",
      "required": false,
      "description": "Conversation end timestamp (null if active)"
    },
    {
      "name": "messageCount",
      "type": "number",
      "required": true,
      "description": "Total number of messages"
    },
    {
      "name": "status",
      "type": "text",
      "required": true,
      "description": "Status (active, paused, ended, archived)"
    },
    {
      "name": "tags",
      "type": "array",
      "required": false,
      "description": "Conversation tags/categories"
    },
    {
      "name": "sentiment",
      "type": "text",
      "required": false,
      "description": "Overall sentiment (positive, neutral, negative)"
    },
    {
      "name": "metadata",
      "type": "object",
      "required": false,
      "description": "Additional conversation metadata"
    },
    {
      "name": "context",
      "type": "text",
      "required": false,
      "description": "Current conversation context (summary)"
    },
    {
      "name": "isArchived",
      "type": "boolean",
      "required": true,
      "description": "Archive flag"
    }
  ],
  "indexes": [
    {
      "name": "conversationId_unique",
      "fields": ["conversationId"],
      "unique": true
    },
    {
      "name": "userId_index",
      "fields": ["userId"],
      "unique": false
    },
    {
      "name": "lastMessageAt_index",
      "fields": ["lastMessageAt"],
      "unique": false
    },
    {
      "name": "status_index",
      "fields": ["status"],
      "unique": false
    },
    {
      "name": "userId_lastMessageAt_composite",
      "fields": ["userId", "lastMessageAt"],
      "unique": false
    }
  ]
}
