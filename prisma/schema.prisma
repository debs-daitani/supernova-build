// This is your Prisma schema file for The dAItaniverse platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  FREE
  UPGRADE
  MEMBER
  ADMIN
}

enum ContentType {
  FRAMEWORK
  TEMPLATE
  WORKSHEET
  VIDEO
  ARTICLE
  COURSE
  RESOURCE
}

enum LessonType {
  VIDEO
  TEXT
  MIXED
  DOWNLOAD
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketCategory {
  TECHNICAL
  BILLING
  FEATURE_REQUEST
  BUG
  OTHER
}

enum PayoutMethod {
  STRIPE
  PAYPAL
  BANK_TRANSFER
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum CommissionType {
  SIGNUP_BONUS
  RECURRING_MONTHLY
  ANNUAL
}

enum ReferralStatus {
  PENDING
  ACTIVE
  CANCELLED
  CHURNED
}

enum ReferralSource {
  LINK
  SOCIAL
  EMAIL
  OTHER
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  password         String
  role             UserRole  @default(FREE)
  mustResetPassword Boolean  @default(false)
  migratedFromWix  Boolean   @default(false)
  migrationDate    DateTime?
  lifetimeAccess   Boolean   @default(false)
  emailConsent     Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  profile            Profile?
  progress           UserProgress[]
  bookmarks          ContentBookmark[]
  programEnrollments ProgramEnrollment[]
  lessonProgress     LessonProgress[]
  certificates       ProgramCertificate[]
  usageTracking      UsageTracking[]
  supportTickets     SupportTicket[]     @relation("TicketUser")
  assignedTickets    SupportTicket[]     @relation("AssignedAdmin")
  ticketMessages     TicketMessage[]
  affiliateProfile   AffiliateProfile?
  referralsMade      Referral[]          @relation("AffiliateUser")
  referralsReceived  Referral[]          @relation("ReferredUser")
  commissions        AffiliateCommission[]
  payouts            AffiliatePayout[]
  emailSubscribers   EmailSubscriber[]
  emailCampaigns     EmailCampaign[]
  emailTemplates     EmailTemplate[]

  @@map("users")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model ContentCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       ContentItem[]

  @@map("content_categories")
}

model ContentItem {
  id           String      @id @default(cuid())
  title        String
  slug         String      @unique
  description  String?
  thumbnail    String?
  type         ContentType
  fileUrl      String?
  videoUrl     String?
  content      String?     @db.Text
  categoryId   String
  tags         String[]
  isPremium    Boolean     @default(false)
  requiredRole UserRole    @default(FREE)
  viewCount    Int         @default(0)
  order        Int         @default(0)
  isPublished  Boolean     @default(true)
  publishedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  category     ContentCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  progress     UserProgress[]
  bookmarks    ContentBookmark[]

  @@index([categoryId])
  @@index([requiredRole])
  @@index([isPublished])
  @@map("content_items")
}

model UserProgress {
  id           String   @id @default(cuid())
  userId       String
  contentId    String
  viewedAt     DateTime @default(now())
  completedAt  DateTime?
  progress     Int      @default(0)
  lastPosition String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      ContentItem  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
  @@map("user_progress")
}

model ContentBookmark {
  id        String   @id @default(cuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   ContentItem  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId])
  @@map("content_bookmarks")
}

model Program {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  description     String?  @db.Text
  thumbnail       String?
  instructor      String?
  durationMinutes Int?
  requiredRole    UserRole @default(FREE)
  isPremium       Boolean  @default(false)
  isPublished     Boolean  @default(true)
  publishedAt     DateTime?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  modules         Module[]
  enrollments     ProgramEnrollment[]
  certificates    ProgramCertificate[]

  @@index([requiredRole])
  @@index([isPublished])
  @@map("programs")
}

model Module {
  id          String   @id @default(cuid())
  programId   String
  title       String
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@index([programId])
  @@map("modules")
}

model Lesson {
  id          String     @id @default(cuid())
  moduleId    String
  title       String
  description String?    @db.Text
  type        LessonType @default(TEXT)
  videoUrl    String?
  content     String?    @db.Text
  fileUrl     String?
  duration    Int?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]

  @@index([moduleId])
  @@map("lessons")
}

model ProgramEnrollment {
  id           String    @id @default(cuid())
  userId       String
  programId    String
  enrolledAt   DateTime  @default(now())
  completedAt  DateTime?
  lastAccessedAt DateTime @default(now())
  progress     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program      Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@index([userId])
  @@index([programId])
  @@map("program_enrollments")
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?
  viewedAt    DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model ProgramCertificate {
  id           String   @id @default(cuid())
  userId       String
  programId    String
  certificateUrl String?
  issuedAt     DateTime @default(now())
  createdAt    DateTime @default(now())

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program      Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@index([userId])
  @@map("program_certificates")
}

model UsageTracking {
  id                      String   @id @default(cuid())
  userId                  String
  month                   String
  supernovaMessages       Int      @default(0)
  emailSubscribers        Int      @default(0)
  socialPostsScheduled    Int      @default(0)
  contentVideosRepurposed Int      @default(0)
  aiImagesGenerated       Int      @default(0)
  aiVideosGenerated       Int      @default(0)
  storageUsedBytes        BigInt   @default(0)
  coursesHosted           Int      @default(0)
  productsListed          Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId])
  @@index([month])
  @@map("usage_tracking")
}

model TierQuota {
  id           String   @id @default(cuid())
  tier         String
  feature      String
  monthlyLimit Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tier, feature])
  @@index([tier])
  @@map("tier_quotas")
}

model MigrationLog {
  id            String   @id @default(cuid())
  adminUserId   String
  csvFilename   String
  importedCount Int      @default(0)
  skippedCount  Int      @default(0)
  errorCount    Int      @default(0)
  errors        Json?
  importedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([adminUserId])
  @@index([importedAt])
  @@map("migration_logs")
}

model QuizResult {
  id              String   @id @default(cuid())
  userId          String
  quizType        String   @default("impact_authenticator")
  bodyScore       Int?
  brainScore      Int?
  businessScore   Int?
  recommendations Json?
  completedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([userId])
  @@map("quiz_results")
}

model SupportTicket {
  id                 String         @id @default(cuid())
  userId             String
  subject            String
  description        String         @db.Text
  status             TicketStatus   @default(OPEN)
  priority           TicketPriority @default(NORMAL)
  category           TicketCategory @default(OTHER)
  assignedToAdminId  String?
  firstResponseAt    DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  lastActivityAt     DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user               User              @relation("TicketUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedAdmin      User?             @relation("AssignedAdmin", fields: [assignedToAdminId], references: [id])
  messages           TicketMessage[]
  attachments        TicketAttachment[]

  @@index([userId])
  @@index([assignedToAdminId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([createdAt])
  @@map("support_tickets")
}

model TicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  userId      String
  message     String   @db.Text
  isInternal  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ticket      SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id])
  attachments TicketAttachment[]

  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
  @@map("ticket_messages")
}

model TicketAttachment {
  id         String   @id @default(cuid())
  ticketId   String
  messageId  String?
  filename   String
  fileUrl    String
  fileSize   Int
  mimeType   String
  uploadedBy String
  createdAt  DateTime @default(now())

  ticket     SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message    TicketMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([messageId])
  @@map("ticket_attachments")
}

model CannedResponse {
  id          String   @id @default(cuid())
  title       String
  category    String
  content     String   @db.Text
  createdBy   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@map("canned_responses")
}

model AffiliateProfile {
  id              String       @id @default(cuid())
  userId          String       @unique
  affiliateCode   String       @unique
  isActive        Boolean      @default(true)
  commissionRate  Decimal      @db.Decimal(5, 2)
  totalEarnings   Decimal      @default(0) @db.Decimal(10, 2)
  pendingEarnings Decimal      @default(0) @db.Decimal(10, 2)
  paidEarnings    Decimal      @default(0) @db.Decimal(10, 2)
  payoutMethod    PayoutMethod @default(STRIPE)
  payoutEmail     String?
  payoutDetails   Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([affiliateCode])
  @@index([isActive])
  @@map("affiliate_profiles")
}

model Referral {
  id              String         @id @default(cuid())
  affiliateUserId String
  referredUserId  String
  affiliateCode   String
  referralSource  ReferralSource @default(LINK)
  clickedAt       DateTime?
  signedUpAt      DateTime       @default(now())
  convertedAt     DateTime?
  status          ReferralStatus @default(PENDING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  affiliate       User                 @relation("AffiliateUser", fields: [affiliateUserId], references: [id], onDelete: Cascade)
  referredUser    User                 @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  commissions     AffiliateCommission[]

  @@index([affiliateUserId])
  @@index([referredUserId])
  @@index([affiliateCode])
  @@index([status])
  @@map("referrals")
}

model AffiliateCommission {
  id               String           @id @default(cuid())
  affiliateUserId  String
  referralId       String
  amount           Decimal          @db.Decimal(10, 2)
  commissionType   CommissionType   @default(RECURRING_MONTHLY)
  status           CommissionStatus @default(PENDING)
  paidAt           DateTime?
  payoutId         String?
  subscriptionMonth String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  affiliate        User             @relation(fields: [affiliateUserId], references: [id], onDelete: Cascade)
  referral         Referral         @relation(fields: [referralId], references: [id], onDelete: Cascade)
  payout           AffiliatePayout? @relation(fields: [payoutId], references: [id])

  @@index([affiliateUserId])
  @@index([referralId])
  @@index([status])
  @@index([payoutId])
  @@index([subscriptionMonth])
  @@map("affiliate_commissions")
}

model AffiliatePayout {
  id             String        @id @default(cuid())
  affiliateUserId String
  amount         Decimal       @db.Decimal(10, 2)
  commissionIds  Json
  method         PayoutMethod  @default(STRIPE)
  status         PayoutStatus  @default(PENDING)
  processedAt    DateTime?
  completedAt    DateTime?
  transactionId  String?
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  affiliate      User                  @relation(fields: [affiliateUserId], references: [id], onDelete: Cascade)
  commissions    AffiliateCommission[]

  @@index([affiliateUserId])
  @@index([status])
  @@index([createdAt])
  @@map("affiliate_payouts")
}

model AffiliateClick {
  id            String   @id @default(cuid())
  affiliateCode String
  ipAddress     String?
  userAgent     String?
  referer       String?
  clickedAt     DateTime @default(now())

  @@index([affiliateCode])
  @@index([clickedAt])
  @@map("affiliate_clicks")
}

// Email Marketing System

enum EmailSubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
}

enum EmailSubscriberSource {
  MANUAL
  IMPORT
  FORM
  API
}

enum EmailCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum EmailRecipientStatus {
  PENDING
  SENT
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
}

model EmailSubscriber {
  id             String                 @id @default(cuid())
  userId         String
  email          String
  firstName      String?
  lastName       String?
  status         EmailSubscriberStatus  @default(SUBSCRIBED)
  source         EmailSubscriberSource  @default(MANUAL)
  subscribedAt   DateTime               @default(now())
  unsubscribedAt DateTime?
  tags           String[]
  customFields   Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns      EmailCampaignRecipient[]

  @@unique([userId, email])
  @@index([userId])
  @@index([email])
  @@index([status])
  @@map("email_subscribers")
}

model EmailCampaign {
  id              String              @id @default(cuid())
  userId          String
  name            String
  subject         String
  previewText     String?
  htmlContent     String              @db.Text
  textContent     String?             @db.Text
  fromName        String
  fromEmail       String
  replyTo         String?
  status          EmailCampaignStatus @default(DRAFT)
  scheduledFor    DateTime?
  sentAt          DateTime?
  completedAt     DateTime?
  totalRecipients Int                 @default(0)
  sentCount       Int                 @default(0)
  openedCount     Int                 @default(0)
  clickedCount    Int                 @default(0)
  bouncedCount    Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipients      EmailCampaignRecipient[]

  @@index([userId])
  @@index([status])
  @@index([scheduledFor])
  @@map("email_campaigns")
}

model EmailCampaignRecipient {
  id           String               @id @default(cuid())
  campaignId   String
  subscriberId String
  status       EmailRecipientStatus @default(PENDING)
  sentAt       DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  openCount    Int                  @default(0)
  clickCount   Int                  @default(0)
  userAgent    String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  campaign     EmailCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber   EmailSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([campaignId, subscriberId])
  @@index([campaignId])
  @@index([subscriberId])
  @@index([status])
  @@map("email_campaign_recipients")
}

model EmailTemplate {
  id           String   @id @default(cuid())
  userId       String?
  name         String
  category     String
  thumbnailUrl String?
  htmlContent  String   @db.Text
  textContent  String?  @db.Text
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([isPublic])
  @@map("email_templates")
}
