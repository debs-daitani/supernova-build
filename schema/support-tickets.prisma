/**
 * Support Ticket System Schema
 * Complete customer support and helpdesk system
 */

// Add to your main User model:
model User {
  // ... existing fields

  // Support ticket relations
  tickets           Ticket[]          @relation("UserTickets")
  assignedTickets   Ticket[]          @relation("AssignedTickets")
  ticketMessages    TicketMessage[]
  cannedResponses   CannedResponse[]
  internalNotes     InternalNote[]

  // Support staff info (optional)
  isSupport         Boolean           @default(false)
  supportRole       String?           // "agent", "supervisor", "admin"
}

// Support Ticket
model Ticket {
  id                String            @id @default(cuid())
  ticketNumber      String            @unique // e.g., "TICKET-001234"

  // User info
  userId            String
  user              User              @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)

  // Ticket content
  subject           String
  description       String            @db.Text
  category          TicketCategory    @default(OTHER)
  priority          TicketPriority    @default(MEDIUM)
  status            TicketStatus      @default(OPEN)

  // Assignment
  assignedToId      String?
  assignedTo        User?             @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt        DateTime?

  // Tags
  tags              String[]          // e.g., ["bug", "urgent", "billing"]

  // Metadata
  source            String?           // "web", "email", "api"
  userAgent         String?
  ipAddress         String?

  // SLA tracking
  firstResponseAt   DateTime?
  firstResponseTime Int?              // Minutes until first response
  resolvedAt        DateTime?
  resolutionTime    Int?              // Minutes to resolution
  closedAt          DateTime?

  // Timestamps
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  lastActivityAt    DateTime          @default(now())

  // Customer satisfaction
  satisfactionRating Int?             // 1-5 stars
  satisfactionComment String?

  // Relations
  messages          TicketMessage[]
  attachments       TicketAttachment[]
  internalNotes     InternalNote[]

  @@index([userId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([createdAt])
  @@index([ticketNumber])
}

enum TicketCategory {
  BUG
  FEATURE_REQUEST
  QUESTION
  BILLING
  ACCOUNT
  TECHNICAL
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN         // New ticket, needs attention
  PENDING      // Waiting on customer
  IN_PROGRESS  // Staff working on it
  RESOLVED     // Issue fixed
  CLOSED       // Ticket archived
}

// Ticket Messages (conversation)
model TicketMessage {
  id                String            @id @default(cuid())
  ticketId          String
  ticket            Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Sender
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  isStaffReply      Boolean           @default(false)

  // Content
  message           String            @db.Text

  // Metadata
  isInternal        Boolean           @default(false) // Internal note, not visible to customer
  emailSent         Boolean           @default(false)
  emailSentAt       DateTime?

  // Timestamps
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relations
  attachments       MessageAttachment[]

  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
}

// File Attachments
model TicketAttachment {
  id                String            @id @default(cuid())
  ticketId          String
  ticket            Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // File info
  fileName          String
  originalName      String
  fileUrl           String
  fileSize          Int               // Bytes
  mimeType          String

  // Upload info
  uploadedBy        String
  uploadedAt        DateTime          @default(now())

  @@index([ticketId])
}

// Message Attachments (files in messages)
model MessageAttachment {
  id                String            @id @default(cuid())
  messageId         String
  message           TicketMessage     @relation(fields: [messageId], references: [id], onDelete: Cascade)

  // File info
  fileName          String
  originalName      String
  fileUrl           String
  fileSize          Int
  mimeType          String

  // Upload info
  uploadedBy        String
  uploadedAt        DateTime          @default(now())

  @@index([messageId])
}

// Canned Responses (pre-written replies)
model CannedResponse {
  id                String            @id @default(cuid())

  // Content
  title             String            // e.g., "Password Reset Instructions"
  content           String            @db.Text
  category          String?           // e.g., "account", "billing", "technical"

  // Usage tracking
  usageCount        Int               @default(0)
  lastUsedAt        DateTime?

  // Metadata
  createdBy         String
  creator           User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Status
  isActive          Boolean           @default(true)

  @@index([category])
  @@index([createdBy])
}

// Internal Notes (staff-only, not visible to customer)
model InternalNote {
  id                String            @id @default(cuid())
  ticketId          String
  ticket            Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Author
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Content
  note              String            @db.Text

  // Timestamps
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([ticketId])
  @@index([userId])
}

// Support Analytics (for tracking metrics)
model SupportMetrics {
  id                String            @id @default(cuid())
  date              DateTime          @unique // Daily metrics

  // Ticket counts
  ticketsCreated    Int               @default(0)
  ticketsResolved   Int               @default(0)
  ticketsClosed     Int               @default(0)

  // Response times (in minutes)
  avgFirstResponse  Float?
  avgResolutionTime Float?

  // Satisfaction
  avgSatisfaction   Float?
  totalRatings      Int               @default(0)

  // Workload
  openTickets       Int               @default(0)
  pendingTickets    Int               @default(0)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([date])
}
