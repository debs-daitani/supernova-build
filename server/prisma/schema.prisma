  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

// ============================================
// PHASE 2AS - MESSAGING PLATFORM
// ============================================

model PlatformConversation {
  id            String        @id @default(cuid())

  // Type
  type          String        // "direct", "group", "channel"

  // Participants (for direct/group)
  participants  String[]      // Array of user IDs

  // Group/Channel info
  name          String?
  description   String?       @db.Text
  avatar        String?

  // Creator (for groups/channels)
  createdBy     String?

  // Settings
  isArchived    Boolean       @default(false)
  isMuted       Boolean       @default(false)

  // Last message (for sorting)
  lastMessageAt DateTime      @default(now())
  lastMessage   String?       @db.Text

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  messages      PlatformMessage[]

  @@index([type])
  @@index([lastMessageAt])
}

model PlatformMessage {
  id            String        @id @default(cuid())
  conversationId String
  conversation  PlatformConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Sender
  senderId      String
  sender        User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Content
  messageType   String        @default("text")  // text, image, video, audio, file, voice_note
  content       String?       @db.Text
  mediaUrl      String?
  fileUrl       String?
  fileName      String?
  fileSize      Int?

  // Voice note
  duration      Int?          // Seconds (for voice/video)

  // Reply/Thread
  replyToId     String?
  replyTo       PlatformMessage?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       PlatformMessage[]     @relation("MessageReplies")

  // Status
  isEdited      Boolean       @default(false)
  isDeleted     Boolean       @default(false)
  deletedAt     DateTime?

  // Read receipts
  readBy        String[]      // Array of user IDs who read message

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model StatusUpdate {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Content
  mediaType     String        // "image", "video", "text"
  mediaUrl      String?
  caption       String?       @db.Text
  backgroundColor String?     // For text-only status

  // Visibility
  viewedBy      String[]      // Array of user IDs who viewed

  // Expiry (24 hours)
  expiresAt     DateTime

  createdAt     DateTime      @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Call {
  id            String        @id @default(cuid())
  conversationId String

  // Type
  callType      String        // "voice", "video"

  // Participants
  callerId      String
  receiverId    String?       // For direct calls
  participants  String[]      // For group calls

  // Status
  status        String        // "ringing", "ongoing", "ended", "missed", "declined"

  // Duration
  startedAt     DateTime?
  endedAt       DateTime?
  duration      Int?          // Seconds

  createdAt     DateTime      @default(now())

  @@index([conversationId])
  @@index([callerId])
}

model BlockedUser {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation("UserBlocks", fields: [userId], references: [id], onDelete: Cascade)

  blockedUserId String
  blockedUser   User          @relation("UserBlockedBy", fields: [blockedUserId], references: [id], onDelete: Cascade)

  createdAt     DateTime      @default(now())

  @@unique([userId, blockedUserId])
  @@index([userId])
}

// ============================================
// PHASE 2J - EVENTS PLATFORM
// ============================================

model Event {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Basic info
  title         String
  slug          String        @unique
  description   String        @db.Text
  coverImage    String?

  // Type
  eventType     String        // "in_person", "virtual", "hybrid"
  category      String        // "workshop", "webinar", "meetup", "conference", "networking"

  // Date & time
  startDateTime DateTime
  endDateTime   DateTime
  timezone      String

  // Location (for in-person/hybrid)
  venueName     String?
  venueAddress  String?
  venueCity     String?
  venuePostcode String?
  venueCountry  String?

  // Virtual (for virtual/hybrid)
  streamUrl     String?       // Meeting link or stream URL
  streamPlatform String?      // "zoom", "teams", "youtube", "custom"

  // Capacity
  maxAttendees  Int?
  unlimitedCapacity Boolean   @default(false)

  // Registration
  requiresApproval Boolean    @default(false)
  registrationDeadline DateTime?

  // Visibility
  isPublic      Boolean       @default(true)
  isPublished   Boolean       @default(false)
  publishedAt   DateTime?

  // Recurring
  isRecurring   Boolean       @default(false)
  recurrence    Json?         // {frequency: "weekly", interval: 1, endDate: ...}

  // Settings
  allowWaitlist Boolean       @default(false)
  sendReminders Boolean       @default(true)
  collectAttendeeInfo Json?   // Custom fields to collect

  // Tickets
  isFree        Boolean       @default(true)

  // SEO
  seoTitle      String?
  seoDescription String?      @db.Text

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  tickets       EventTicket[]
  registrations EventRegistration[]
  sessions      EventSession[]

  @@index([userId])
  @@index([eventType])
  @@index([category])
  @@index([startDateTime])
  @@index([isPublished])
}

model EventTicket {
  id            String        @id @default(cuid())
  eventId       String
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Ticket info
  name          String        // "General Admission", "VIP", "Early Bird"
  description   String?       @db.Text

  // Pricing
  price         Float
  currency      String        @default("GBP")

  // Availability
  quantity      Int?          // null = unlimited
  sold          Int           @default(0)

  // Sales period
  salesStart    DateTime?
  salesEnd      DateTime?

  // Settings
  minPerOrder   Int           @default(1)
  maxPerOrder   Int           @default(10)

  @@index([eventId])
}

model EventRegistration {
  id            String        @id @default(cuid())
  eventId       String
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Attendee info
  attendeeName  String
  attendeeEmail String
  attendeePhone String?
  userId        String?       // If registered user

  // Ticket
  ticketId      String?
  ticketName    String?

  // Payment
  orderTotal    Float         @default(0)
  paymentStatus String        @default("pending")  // pending, paid, refunded
  paymentId     String?

  // Status
  status        String        @default("confirmed")  // confirmed, cancelled, waitlist, checked_in

  // Check-in
  checkedIn     Boolean       @default(false)
  checkedInAt   DateTime?

  // Custom fields
  customData    Json?

  // Communication
  confirmationSent Boolean    @default(false)
  reminderSent  Boolean       @default(false)

  createdAt     DateTime      @default(now())

  @@index([eventId])
  @@index([attendeeEmail])
  @@index([status])
}

model EventSession {
  id            String        @id @default(cuid())
  eventId       String
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Session info (for multi-session events)
  title         String
  description   String?       @db.Text

  // Time
  startTime     DateTime
  endTime       DateTime

  // Speaker
  speakerName   String?
  speakerBio    String?       @db.Text
  speakerPhoto  String?

  // Location (if different from main event)
  location      String?

  order         Int           @default(0)

  @@index([eventId])
}

// ============================================================================
// Phase 2O - Legal Templates + Launch Toolkit
// ============================================================================

model LegalDocument {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Document type
  documentType  String        // "terms", "privacy", "contract", "nda", "disclaimer", etc.

  // Content
  title         String
  content       String        @db.Text

  // Business details used to generate
  businessInfo  Json          // Name, address, contact, etc.

  // Version control
  version       Int           @default(1)

  // Status
  isActive      Boolean       @default(true)
  publishedAt   DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([documentType])
}

model Launch {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Launch details
  name          String        // "Product Launch", "Business Launch", etc.
  description   String?       @db.Text
  launchDate    DateTime

  // Type
  launchType    String        // "product", "service", "course", "book", "event", "business"

  // Goals
  goals         Json          // {revenue: 10000, signups: 100, etc.}

  // Status
  status        String        @default("planning")  // planning, pre_launch, launched, post_launch

  // Waitlist
  waitlistCount Int           @default(0)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  checklist     LaunchChecklistItem[]
  waitlist      WaitlistEntry[]

  @@index([userId])
  @@index([launchDate])
}

model LaunchChecklistItem {
  id            String        @id @default(cuid())
  launchId      String
  launch        Launch        @relation(fields: [launchId], references: [id], onDelete: Cascade)

  // Task
  task          String
  description   String?       @db.Text
  category      String        // "marketing", "technical", "legal", "content", "logistics"

  // Timeline
  dueDate       DateTime?

  // Status
  completed     Boolean       @default(false)
  completedAt   DateTime?

  order         Int           @default(0)

  @@index([launchId])
  @@index([completed])
}

model WaitlistEntry {
  id            String        @id @default(cuid())
  launchId      String
  launch        Launch        @relation(fields: [launchId], references: [id], onDelete: Cascade)

  // Contact info
  email         String
  name          String?

  // Referral tracking
  referredBy    String?       // Email of referrer
  referralCount Int           @default(0)

  // Position
  position      Int           // Their place in line

  // Status
  notified      Boolean       @default(false)
  converted     Boolean       @default(false)

  createdAt     DateTime      @default(now())

  @@index([launchId])
  @@index([email])
}

