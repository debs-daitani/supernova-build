// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model (simplified - can be extended with NextAuth later)
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  firstName     String?
  lastName      String?
  username      String?   @unique
  passwordHash  String?

  // Profile fields
  profilePhotoUrl String?
  bio             String?   @db.Text
  pronouns        String?

  // Social links
  twitterHandle   String?
  linkedinUrl     String?
  instagramHandle String?
  websiteUrl      String?

  // Preferences
  timezone        String?   @default("UTC")
  theme           String?   @default("SYSTEM") // LIGHT, DARK, SYSTEM
  language        String?   @default("en")

  // Legacy field (for backwards compatibility)
  avatar        String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // Soft delete

  websites        Website[]
  blocks          WebsiteBlock[]
  formSubmissions FormSubmission[]
  preferences     UserPreferences?
  designs         UserDesign[]
  designAssets    DesignAsset[]
  brandKit        BrandKit?
  aiImages        AIImage[]
  videos          Video[]
  videoClips      VideoClip[]

  @@map("users")
}

// User Preferences model
model UserPreferences {
  id        String   @id @default(cuid())
  userId    String   @unique

  // Email preferences
  emailMarketing Boolean @default(true)
  emailUpdates   Boolean @default(true)
  emailDigest    Boolean @default(true)
  emailSupport   Boolean @default(true)

  // Notification preferences
  notifBrowser   Boolean @default(false)
  notifEmail     Boolean @default(true)
  notifInApp     Boolean @default(true)

  // Per-feature notifications
  notifTickets   Boolean @default(true)
  notifCampaigns Boolean @default(true)
  notifSocial    Boolean @default(true)
  notifWebsites  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// Website model
model Website {
  id              String    @id @default(cuid())
  userId          String
  name            String
  domain          String    @unique  // subdomain or custom domain
  subdomain       String    @unique  // username.daitaniverse.site
  isPublished     Boolean   @default(false)

  // Theme settings (stored as JSON)
  theme           Json?     @default("{\"primaryColor\":\"#ec4899\",\"secondaryColor\":\"#8b5cf6\",\"accentColor\":\"#f59e0b\",\"fontFamily\":\"Inter\",\"fontHeadingFamily\":\"Montserrat\"}")

  // Branding
  favicon         String?
  logo            String?

  // SEO
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?

  // Analytics & Custom Code
  analyticsCode   String?   @db.Text
  customCSS       String?   @db.Text
  customJS        String?   @db.Text
  robotsTxt       String?   @db.Text

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  publishedAt     DateTime?

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages           WebsitePage[]

  @@index([userId])
  @@index([domain])
  @@index([subdomain])
  @@map("websites")
}

// WebsitePage model
model WebsitePage {
  id              String    @id @default(cuid())
  websiteId       String
  title           String
  slug            String
  isHomepage      Boolean   @default(false)

  // Page content (stored as JSON - array of blocks/sections)
  content         Json      @default("[]")

  // SEO
  seoTitle        String?
  seoDescription  String?
  seoImage        String?

  isPublished     Boolean   @default(false)
  order           Int       @default(0)  // for navigation menu ordering

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  website         Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, slug])
  @@index([websiteId])
  @@index([slug])
  @@map("website_pages")
}

// WebsiteBlock model (reusable blocks)
model WebsiteBlock {
  id              String    @id @default(cuid())
  userId          String
  name            String
  category        String    // hero, features, testimonials, pricing, etc.

  thumbnail       String?
  preview         String?   @db.Text

  // Block structure (stored as JSON)
  content         Json

  isPublic        Boolean   @default(false)  // shared blocks

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([isPublic])
  @@map("website_blocks")
}

// WebsiteTemplate model
model WebsiteTemplate {
  id              String    @id @default(cuid())
  name            String
  category        String    // landing-page, portfolio, business, blog, etc.
  description     String?   @db.Text

  thumbnail       String?
  preview         String?   @db.Text

  // Template pages structure (stored as JSON)
  pages           Json      // array of page structures

  // Theme settings for template
  theme           Json?

  isPublic        Boolean   @default(true)
  isFeatured      Boolean   @default(false)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([category])
  @@index([isPublic])
  @@index([isFeatured])
  @@map("website_templates")
}

// FormSubmission model
model FormSubmission {
  id              String    @id @default(cuid())
  userId          String    // website owner
  websiteId       String
  pageId          String?
  formName        String    // contact-form, newsletter, etc.

  // Form data (stored as JSON)
  data            Json

  // Common fields (extracted for easy filtering)
  name            String?
  email           String?
  phone           String?
  message         String?   @db.Text

  isRead          Boolean   @default(false)
  ipAddress       String?
  userAgent       String?   @db.Text

  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([websiteId])
  @@index([formName])
  @@index([isRead])
  @@index([createdAt])
  @@map("form_submissions")
}

// ========================================
// DESIGN TOOLS MODELS
// ========================================

// DesignTemplate model (pre-made templates)
model DesignTemplate {
  id          String   @id @default(cuid())
  name        String
  category    String   // social-media, marketing, business, youtube, other
  
  // Dimensions
  width       Int
  height      Int
  
  // Visuals
  thumbnailUrl String?
  previewUrl   String?
  
  // Canvas data (Fabric.js JSON)
  jsonData    Json
  
  // Metadata
  tags        String[] @default([])
  isPublic    Boolean  @default(true)
  createdBy   String?  // userId or null for platform templates
  usageCount  Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  designs     UserDesign[]
  
  @@index([category])
  @@index([isPublic])
  @@index([createdBy])
  @@map("design_templates")
}

// UserDesign model (user-created designs)
model UserDesign {
  id           String   @id @default(cuid())
  userId       String
  name         String
  
  // Template reference
  templateId   String?
  
  // Dimensions
  width        Int
  height       Int
  
  // Visuals
  thumbnailUrl String?
  
  // Canvas data (Fabric.js JSON)
  jsonData     Json
  
  // Metadata
  category     String?
  tags         String[] @default([])
  isPublic     Boolean  @default(false)
  
  lastEditedAt DateTime @updatedAt
  createdAt    DateTime @default(now())
  
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template     DesignTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([templateId])
  @@index([category])
  @@map("user_designs")
}

// DesignAsset model (uploaded images, icons, etc.)
model DesignAsset {
  id           String   @id @default(cuid())
  userId       String
  name         String
  type         String   // IMAGE, ICON, SHAPE, PHOTO
  
  // File info
  fileUrl      String
  thumbnailUrl String?
  fileSize     Int      // in bytes
  mimeType     String
  
  // Dimensions
  width        Int?
  height       Int?
  
  // Metadata
  tags         String[] @default([])
  isPublic     Boolean  @default(false)
  
  createdAt    DateTime @default(now())
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([type])
  @@map("design_assets")
}

// BrandKit model (user's brand colors and fonts)
model BrandKit {
  id          String   @id @default(cuid())
  userId      String   @unique

  // Brand colors (array of hex colors)
  colors      String[] @default([])

  // Brand fonts
  primaryFont   String?  @default("Inter")
  secondaryFont String?  @default("Montserrat")

  // Logo
  logoUrl     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("brand_kits")
}

// ========================================
// AI IMAGE GENERATION MODELS
// ========================================

// AIImage model (AI-generated images)
model AIImage {
  id              String   @id @default(cuid())
  userId          String

  // Prompts
  prompt          String   @db.Text
  negativePrompt  String?  @db.Text

  // Model and settings
  model           String   // DALLE3, DALLE2, MIDJOURNEY, STABLE_DIFFUSION
  style           String?  // REALISTIC, ARTISTIC, ANIME, DIGITAL_ART, PHOTOGRAPHIC, etc.
  size            String   // 1024x1024, 1024x1792, 1792x1024, etc.

  // Advanced settings
  steps           Int?     // For Stable Diffusion (20-50)
  cfgScale        Float?   // For Stable Diffusion (7-15)
  seed            String?  // For reproducibility

  // Results
  imageUrl        String?
  thumbnailUrl    String?

  // Status
  status          String   @default("GENERATING") // GENERATING, COMPLETED, FAILED
  errorMessage    String?  @db.Text

  // Metadata
  isPublic        Boolean  @default(false)
  usedInDesign    Boolean  @default(false)
  downloadCount   Int      @default(0)

  generatedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([model])
  @@index([style])
  @@index([isPublic])
  @@index([createdAt])
  @@map("ai_images")
}

// AIImageStyle model (style presets)
model AIImageStyle {
  id              String   @id @default(cuid())
  name            String
  description     String?  @db.Text

  // Visual
  thumbnailUrl    String?
  category        String   // realistic, artistic, digital, 3d, etc.

  // Prompt modifiers
  promptModifier  String   @db.Text  // Text to append to user prompts
  negativePrompt  String?  @db.Text  // Default negative prompt

  // Model preferences
  model           String   // DALLE3, DALLE2, STABLE_DIFFUSION, etc.
  settings        Json?    // Additional settings as JSON

  // Metadata
  isPublic        Boolean  @default(true)
  isPremium       Boolean  @default(false)  // Requires BADASS tier
  usageCount      Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([isPublic])
  @@index([isPremium])
  @@map("ai_image_styles")
}

// ========================================
// VIDEO EDITOR & REPURPOSING MODELS
// ========================================

// Video model (uploaded videos)
model Video {
  id              String   @id @default(cuid())
  userId          String

  // Metadata
  title           String
  description     String?  @db.Text

  // Files
  originalUrl     String
  processedUrl    String?
  thumbnailUrl    String?

  // Video properties
  duration        Int      // in seconds
  width           Int
  height          Int
  fileSize        Int      // in bytes
  format          String?  // MP4, MOV, AVI

  // Status
  status          String   @default("UPLOADING") // UPLOADING, PROCESSING, READY, FAILED
  errorMessage    String?  @db.Text

  // Timestamps
  uploadedAt      DateTime @default(now())
  processedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  clips           VideoClip[]
  transcript      VideoTranscript?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("videos")
}

// VideoClip model (extracted clips)
model VideoClip {
  id              String   @id @default(cuid())
  videoId         String
  userId          String

  // Metadata
  title           String
  description     String?  @db.Text

  // Timing
  startTime       Float    // in seconds
  endTime         Float    // in seconds
  duration        Float    // in seconds

  // Files
  clipUrl         String?
  thumbnailUrl    String?

  // Format
  aspectRatio     String   // 16:9, 9:16, 1:1, 4:5
  width           Int
  height          Int

  // Captions
  captions        Json?    // Subtitle data with timing

  // Status
  status          String   @default("PROCESSING") // PROCESSING, READY, FAILED
  errorMessage    String?  @db.Text

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([videoId])
  @@index([status])
  @@map("video_clips")
}

// VideoTemplate model (platform-specific templates)
model VideoTemplate {
  id              String   @id @default(cuid())
  name            String
  platform        String   // YOUTUBE_SHORT, INSTAGRAM_REEL, TIKTOK, LINKEDIN

  // Format specs
  aspectRatio     String   // 16:9, 9:16, 1:1, 4:5
  maxDuration     Int      // in seconds
  recommendedWidth  Int
  recommendedHeight Int

  // Styling
  captionStyle    Json     // Font, color, position, animation
  overlays        Json?    // Logo, CTA positions

  // Metadata
  thumbnailUrl    String?
  description     String?  @db.Text
  isPublic        Boolean  @default(true)
  usageCount      Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([platform])
  @@index([isPublic])
  @@map("video_templates")
}

// VideoTranscript model (speech-to-text)
model VideoTranscript {
  id              String   @id @default(cuid())
  videoId         String   @unique

  // Transcript data
  fullText        String   @db.Text
  segments        Json     // Timestamped words/phrases
  language        String   @default("en")

  // Metadata
  generatedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@map("video_transcripts")
}

// ========================================
// ANALYTICS DASHBOARD MODELS
// ========================================

// AnalyticsEvent model (raw events)
model AnalyticsEvent {
  id              String   @id @default(cuid())
  userId          String?

  // Event details
  eventType       String   // page_view, feature_use, conversion, etc.
  eventCategory   String   // PAGE_VIEW, FEATURE_USE, CONVERSION, ENGAGEMENT, REVENUE
  eventData       Json?    // Flexible data storage

  // Session info
  sessionId       String
  deviceType      String?  // desktop, mobile, tablet
  browser         String?
  os              String?

  // Location
  ipAddress       String?
  country         String?
  city            String?

  // Traffic source
  referrer        String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?

  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([eventCategory])
  @@index([sessionId])
  @@index([createdAt])
  @@map("analytics_events")
}

// AnalyticsSession model
model AnalyticsSession {
  id              String   @id @default(cuid())
  userId          String?
  sessionId       String   @unique

  // Session timing
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  duration        Int?     // in seconds

  // Activity
  pageViews       Int      @default(0)
  eventsCount     Int      @default(0)

  // Device info
  deviceType      String?
  browser         String?
  os              String?

  // Pages
  entryPage       String?
  exitPage        String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([sessionId])
  @@index([startedAt])
  @@map("analytics_sessions")
}

// AnalyticsMetric model (aggregated daily metrics)
model AnalyticsMetric {
  id              String   @id @default(cuid())
  date            DateTime @db.Date
  metricType      String   // dau, wau, mau, revenue, etc.
  metricValue     Float
  metadata        Json?    // Additional context

  createdAt       DateTime @default(now())

  @@unique([date, metricType])
  @@index([date])
  @@index([metricType])
  @@map("analytics_metrics")
}

// UserActivity model (daily user activity summary)
model UserActivity {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime @db.Date

  // Activity summary
  loginCount      Int      @default(0)
  featuresUsed    String[] @default([])
  timeSpent       Int      @default(0) // in minutes
  actionsCount    Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("user_activities")
}
